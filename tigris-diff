# tigris-diff - what changed between two runs
#
#   tigris-diff [-a] [-j] [-l LOGDIR] [OLD.jsonl [NEW.jsonl]]
#
# Compares the JSON Lines reports of two runs and lists the findings that
# are new in the second and the ones that were resolved since the first.
# A finding is the same finding when its level, id and message are the
# same. With no files, the two most recent runs in the log directory are
# compared; with one, that run and the one before it. A new finding that
# is already accepted (tigris-accept) is listed, marked so, and does not
# count as new for the exit status.
#
#   -a   include INFO findings (left out by default)
#   -j   write the result as one JSON object instead of text
#   -l   the log directory (default: ./log if it exists, else /var/log/tiger)
#
# Exit status: 0 when nothing new is open, 1 when something is, 2 on error.
#
#-----------------------------------------------------------------------------

# The JSON escapes every byte above 127 as \u00XX and the decoder turns each
# back into one byte. That only holds in the C locale: gawk in a UTF-8 locale
# would make Unicode characters of them and garble a multi-byte file name.
LC_ALL=C
export LC_ALL

all=N
json=N
logdir=
while [ $# -gt 0 ]
do
  case "$1" in
    -a) all=Y ;;
    -j) json=Y ;;
    -l) logdir=$2; shift ;;
    -h|--help) sed -n '18,35p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) echo "tigris-diff: unknown option $1" >&2; exit 2 ;;
    *)  break ;;
  esac
  shift
done

if [ $# -lt 2 ]; then
  [ -n "$logdir" ] || { if [ -d ./log ]; then logdir=./log; else logdir=/var/log/tiger; fi; }
  # newest last, by name: the date stamp sorts
  set -- $# "$@" `ls "$logdir"/security.report.*.jsonl 2>/dev/null | sort`
  n=$1; shift
  if [ "$n" -eq 1 ]; then
    new=$1; shift
    old=
    for f; do case "${f##*/}" in "${new##*/}") break ;; *) old=$f ;; esac; done
    [ -n "$old" ] || { echo "tigris-diff: no run before $new in $logdir" >&2; exit 2; }
  else
    [ $# -ge 2 ] || { echo "tigris-diff: need two runs to compare; $logdir has $#" >&2; exit 2; }
    while [ $# -gt 2 ]; do shift; done
    old=$1; new=$2
  fi
else
  old=$1; new=$2
fi
for f in "$old" "$new"
do
  [ -r "$f" ] || { echo "tigris-diff: cannot read $f" >&2; exit 2; }
done

awk -v all="$all" -v json="$json" -v oldfile="$old" -v newfile="$new" '
# The raw value of a string field, escapes kept, so two records with the
# same bytes compare equal without decoding.
function jraw(rec, key,    i, s, out, c, n) {
  i = index(rec, "\"" key "\":\"")
  if (i == 0) return ""
  s = substr(rec, i + length(key) + 4); out = ""; n = length(s)
  for (i = 1; i <= n; i++) {
    c = substr(s, i, 1)
    if (c == "\\") { out = out c substr(s, i + 1, 1); i++ }
    else if (c == "\"") break
    else out = out c
  }
  return out
}
function hex(h,    v, i) {
  v = 0
  for (i = 1; i <= length(h); i++) v = v * 16 + index("0123456789abcdef", tolower(substr(h, i, 1))) - 1
  return v
}
# The same, decoded for people
function jtext(rec, key,    s, out, c, i, n) {
  s = jraw(rec, key); out = ""; n = length(s)
  for (i = 1; i <= n; i++) {
    c = substr(s, i, 1)
    if (c != "\\") { out = out c; continue }
    i++; c = substr(s, i, 1)
    if (c == "n") out = out "\n"
    else if (c == "t") out = out "\t"
    else if (c == "u") { out = out sprintf("%c", hex(substr(s, i + 1, 4))); i += 4 }
    else out = out c
  }
  return out
}
function take(rec, which,    key, level) {
  if (index(rec, "\"type\":\"finding\"") == 0) {
    if (index(rec, "\"type\":\"run\"") > 0) run[which] = rec
    # a check skipped in either run (it needs root, or reads only a running
    # system) is left out of both
    if (index(rec, "\"type\":\"skip\"") > 0 && !(jraw(rec, "check") in skipped)) skipped[jraw(rec, "check")] = ++nskipped
    return
  }
  # Findings of the filesystem scan (all fsys*) are only comparable when both
  # runs did the scan; the END block decides, so keep them apart for now
  if (substr(jraw(rec, "id"), 1, 4) == "fsys") fsys[which, ++nfsys[which]] = rec
  level = jraw(rec, "level")
  if (level == "INFO" && all != "Y") return
  key = level "\t" jraw(rec, "id") "\t" jraw(rec, "message")
  if (which == 1) { old[key] = rec; oldorder[++nold] = key }
  else            { new[key] = rec; neworder[++nnew] = key }
}
function who(which,    r) {
  r = run[which]
  if (r == "") return (which == 1 ? oldfile : newfile)
  return jtext(r, "host") " " jtext(r, "start")
}
FNR == NR { take($0, 1); next }
          { take($0, 2) }
END {
  # A run that did not scan the file system has no fsys* findings because
  # it did not look; comparing them would report those of the other run as new or
  # resolved. Older reports have no filesystem_scan field: they scanned.
  noscan1 = (index(run[1], "\"filesystem_scan\":false") > 0)
  noscan2 = (index(run[2], "\"filesystem_scan\":false") > 0)
  setaside = (noscan1 || noscan2)
  if (setaside) {
    for (i = 1; i <= nold; i++) if (substr(oldorder[i], index(oldorder[i], "\t") + 1, 4) == "fsys") { delete old[oldorder[i]]; oldorder[i] = "" }
    for (i = 1; i <= nnew; i++) if (substr(neworder[i], index(neworder[i], "\t") + 1, 4) == "fsys") { delete new[neworder[i]]; neworder[i] = "" }
  }
  # a profile on top of the tigerrc counts as part of the configuration
  for (r = 1; r <= 2; r++) {
    c = jtext(run[r], "config"); p = jtext(run[r], "profile"); o = jtext(run[r], "root")
    cfg[r] = c "|" p "|" o; show[r] = (c == "" ? "?" : c) (p == "" ? "" : " with profile " p) (o == "" ? "" : " of " o)
  }
  config1 = cfg[1]; config2 = cfg[2]
  if (nskipped) {
    for (i = 1; i <= nold; i++) if (oldorder[i] != "" && (jraw(old[oldorder[i]], "check") in skipped)) { delete old[oldorder[i]]; oldorder[i] = "" }
    for (i = 1; i <= nnew; i++) if (neworder[i] != "" && (jraw(new[neworder[i]], "check") in skipped)) { delete new[neworder[i]]; neworder[i] = "" }
    for (c in skipped) skipname[skipped[c]] = c
  }
  nres = 0; nadd = 0; same = 0
  for (i = 1; i <= nold; i++) { k = oldorder[i]; if (k == "") continue; if (!(k in new)) resolved[++nres] = k; else same++ }
  nopen = 0
  for (i = 1; i <= nnew; i++) { k = neworder[i]; if (k == "") continue; if (!(k in old)) { added[++nadd] = k; if (!index(new[k], "\"accepted\":{")) nopen++ } }
  if (json == "Y") {
    printf "{\"type\":\"diff\",\"from\":%s,\"to\":%s,", (run[1] == "" ? "null" : run[1]), (run[2] == "" ? "null" : run[2])
    printf "\"new\":["
    for (i = 1; i <= nadd; i++) printf "%s%s", (i > 1 ? "," : ""), new[added[i]]
    printf "],\"resolved\":["
    for (i = 1; i <= nres; i++) printf "%s%s", (i > 1 ? "," : ""), old[resolved[i]]
    printf "],\"unchanged\":%d", same
    if (setaside) printf ",\"set_aside\":[\"fsys\"]"
    if (config1 != config2) printf ",\"configs_differ\":true"
    if (nskipped) {
      printf ",\"skipped_checks\":["
      for (i = 1; i <= nskipped; i++) printf "%s\"%s\"", (i > 1 ? "," : ""), skipname[i]
      printf "]"
    }
    printf "}\n"
  } else {
    printf "Tigris diff: %s -> %s\n", who(1), who(2)
    if (setaside)
      printf "  note: %s, so its findings (fsys*) are left out of both sides\n", (noscan1 && noscan2 ? "neither run scanned the file system" : (noscan1 ? "the first run did not scan the file system" : "the second run did not scan the file system"))
    if (config1 != config2)
      printf "  note: the runs used different configurations (%s, %s); a check on in only one of them shows its findings as new or resolved\n", show[1], show[2]
    if (nskipped) {
      printf "  note: skipped in either run (not root, or a check that cannot read an offline root), so left out of both sides:"
      for (i = 1; i <= nskipped; i++) printf "%s %s", (i > 1 ? "," : ""), skipname[i]
      printf "\n"
    }
    printf "  new (%d):\n", nadd
    for (i = 1; i <= nadd; i++) { r = new[added[i]]; printf "    + %-5s %s %s%s\n", jtext(r, "level"), jtext(r, "id"), jtext(r, "message"), (index(r, "\"accepted\":{") ? " (accepted)" : "") }
    printf "  resolved (%d):\n", nres
    for (i = 1; i <= nres; i++) { r = old[resolved[i]]; printf "    - %-5s %s %s\n", jtext(r, "level"), jtext(r, "id"), jtext(r, "message") }
    printf "  unchanged: %d%s\n", same, (all == "Y" ? "" : " (INFO not compared; -a includes it)")
  }
  exit (nopen > 0 ? 1 : 0)
}' "$old" "$new"
