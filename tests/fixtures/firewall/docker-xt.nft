table ip nat {
	chain DOCKER {
		iifname != "docker0" tcp dport 8080 counter packets 0 bytes 0 xt target "DNAT"
		iifname != "docker0" udp dport 5353 counter packets 0 bytes 0 xt target "DNAT"
		ip daddr 127.0.0.1 iifname != "docker0" tcp dport 8081 counter packets 0 bytes 0 xt target "DNAT"
		ip daddr 172.17.0.2 iifname != "docker0" tcp dport 8082 counter packets 0 bytes 0 xt target "DNAT"
		iifname != "br-50f68fe4ba45" tcp dport 8443 counter packets 0 bytes 0 xt target "DNAT"
	}

	chain PREROUTING {
		type nat hook prerouting priority dstnat; policy accept;
		xt match "addrtype" counter packets 0 bytes 0 jump DOCKER
	}

	chain OUTPUT {
		type nat hook output priority dstnat; policy accept;
		ip daddr != 127.0.0.0/8 xt match "addrtype" counter packets 0 bytes 0 jump DOCKER
	}

	chain POSTROUTING {
		type nat hook postrouting priority srcnat; policy accept;
		ip saddr 172.19.0.0/16 oifname != "br-50f68fe4ba45" counter packets 0 bytes 0 xt target "MASQUERADE"
		ip saddr 172.18.0.0/16 oifname != "docker0" counter packets 0 bytes 0 xt target "MASQUERADE"
	}
}
table ip filter {
	chain DOCKER {
		ip daddr 172.19.0.2 iifname != "br-50f68fe4ba45" oifname "br-50f68fe4ba45" tcp dport 443 counter packets 0 bytes 0 accept
		ip daddr 172.18.0.4 iifname != "docker0" oifname "docker0" tcp dport 80 counter packets 0 bytes 0 accept
		ip daddr 172.18.0.3 iifname != "docker0" oifname "docker0" tcp dport 80 counter packets 0 bytes 0 accept
		ip daddr 172.18.0.2 iifname != "docker0" oifname "docker0" udp dport 5353 counter packets 0 bytes 0 accept
		ip daddr 172.18.0.2 iifname != "docker0" oifname "docker0" tcp dport 80 counter packets 0 bytes 0 accept
		iifname != "docker0" oifname "docker0" counter packets 0 bytes 0 drop
		iifname != "br-50f68fe4ba45" oifname "br-50f68fe4ba45" counter packets 0 bytes 0 drop
	}

	chain DOCKER-FORWARD {
		counter packets 0 bytes 0 jump DOCKER-CT
		counter packets 0 bytes 0 jump DOCKER-INTERNAL
		counter packets 0 bytes 0 jump DOCKER-BRIDGE
		iifname "docker0" counter packets 0 bytes 0 accept
		iifname "br-50f68fe4ba45" counter packets 0 bytes 0 accept
	}

	chain DOCKER-BRIDGE {
		oifname "docker0" counter packets 0 bytes 0 jump DOCKER
		oifname "br-50f68fe4ba45" counter packets 0 bytes 0 jump DOCKER
	}

	chain DOCKER-CT {
		oifname "docker0" xt match "conntrack" counter packets 0 bytes 0 accept
		oifname "br-50f68fe4ba45" xt match "conntrack" counter packets 0 bytes 0 accept
	}

	chain DOCKER-INTERNAL {
	}

	chain FORWARD {
		type filter hook forward priority filter; policy accept;
		counter packets 0 bytes 0 jump DOCKER-USER
		counter packets 0 bytes 0 jump DOCKER-FORWARD
	}

	chain DOCKER-USER {
	}
}
table ip6 nat {
	chain DOCKER {
		ip6 saddr != fe80::/10 iifname != "br-50f68fe4ba45" tcp dport 8443 counter packets 0 bytes 0 xt target "DNAT"
	}

	chain PREROUTING {
		type nat hook prerouting priority dstnat; policy accept;
		xt match "addrtype" counter packets 0 bytes 0 jump DOCKER
	}

	chain OUTPUT {
		type nat hook output priority dstnat; policy accept;
		ip6 daddr != ::1 xt match "addrtype" counter packets 0 bytes 0 jump DOCKER
	}

	chain POSTROUTING {
		type nat hook postrouting priority srcnat; policy accept;
		ip6 saddr fd00:dead::/64 oifname != "br-50f68fe4ba45" counter packets 0 bytes 0 xt target "MASQUERADE"
	}
}
table ip6 filter {
	chain DOCKER {
		ip6 daddr fd00:dead::2 iifname != "br-50f68fe4ba45" oifname "br-50f68fe4ba45" tcp dport 443 counter packets 0 bytes 0 accept
		iifname != "br-50f68fe4ba45" oifname "br-50f68fe4ba45" counter packets 0 bytes 0 drop
	}

	chain DOCKER-FORWARD {
		counter packets 0 bytes 0 jump DOCKER-CT
		counter packets 0 bytes 0 jump DOCKER-INTERNAL
		counter packets 0 bytes 0 jump DOCKER-BRIDGE
		iifname "br-50f68fe4ba45" counter packets 0 bytes 0 accept
	}

	chain DOCKER-BRIDGE {
		oifname "br-50f68fe4ba45" counter packets 0 bytes 0 jump DOCKER
	}

	chain DOCKER-CT {
		oifname "br-50f68fe4ba45" xt match "conntrack" counter packets 0 bytes 0 accept
	}

	chain DOCKER-INTERNAL {
	}

	chain FORWARD {
		type filter hook forward priority filter; policy drop;
		counter packets 0 bytes 0 jump DOCKER-USER
		counter packets 0 bytes 0 jump DOCKER-FORWARD
	}

	chain DOCKER-USER {
	}
}
table ip raw {
	chain PREROUTING {
		type filter hook prerouting priority raw; policy accept;
		ip daddr 172.18.0.2 iifname != "docker0" counter packets 0 bytes 0 drop
		ip daddr 172.18.0.3 iifname != "docker0" counter packets 0 bytes 0 drop
		ip daddr 127.0.0.1 iifname != "lo" tcp dport 8081 counter packets 0 bytes 0 drop
		ip daddr 172.18.0.4 iifname != "docker0" counter packets 0 bytes 0 drop
		ip daddr 172.19.0.2 iifname != "br-50f68fe4ba45" counter packets 0 bytes 0 drop
	}
}
table ip6 raw {
	chain PREROUTING {
		type filter hook prerouting priority raw; policy accept;
		ip6 daddr fd00:dead::2 iifname != "br-50f68fe4ba45" counter packets 0 bytes 0 drop
	}
}
