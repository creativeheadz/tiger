table ip6 filter {
	chain input {
		type filter hook input priority filter; policy accept;
		ct state established,related accept
		log prefix "in-drop: " counter packets 0 bytes 0 reject with icmpv6 admin-prohibited
	}
}
table ip filter {
	set allowed {
		type ipv4_addr
		elements = { 10.0.0.1, 10.0.0.2 }
	}

	chain input {
		type filter hook input priority filter; policy accept;
		ip saddr @allowed accept
		log prefix "v4 " counter packets 0 bytes 0 drop
	}
}
