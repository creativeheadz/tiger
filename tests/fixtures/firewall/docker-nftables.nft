	chain nat-prerouting-and-output {
		iifname != "br-cff60ae07f59" ip6 saddr != fe80::/10 tcp dport 8443 counter packets 0 bytes 0 dnat to [fd00:dead::2]:443 comment "DNAT"
	}

	chain raw-PREROUTING {
		type filter hook prerouting priority raw; policy accept;
		ip6 daddr fd00:dead::2 iifname != "br-cff60ae07f59" counter packets 0 bytes 0 drop comment "DROP DIRECT ACCESS"
