	chain filter-forward-in__br-cff60ae07f59 {
		ct state established,related counter packets 0 bytes 0 accept
		iifname "br-cff60ae07f59" counter packets 0 bytes 0 accept comment "ICC"
		ip6 daddr fd00:dead::2 tcp dport 443 counter packets 0 bytes 0 accept
		counter packets 0 bytes 0 drop comment "UNPUBLISHED PORT DROP"
	}

	chain filter-forward-out__br-cff60ae07f59 {
		ct state established,related counter packets 0 bytes 0 accept
		counter packets 0 bytes 0 accept comment "OUTGOING"
	}

	chain nat-postrouting-in__br-cff60ae07f59 {
	}

	chain nat-postrouting-out__br-cff60ae07f59 {
		oifname != "br-cff60ae07f59" ip6 saddr fd00:dead::/64 counter packets 0 bytes 0 masquerade comment "MASQUERADE"
	}
}
