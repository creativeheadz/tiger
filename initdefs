#
# Routines for verifying environment
#
# haveallcmds - verify command variables
# haveallfiles - verify files
# haveallvars - verify variables
#
haveallcmds()
# Note:
# In some cases haveallcmds might fail if the program is not installed
# (such as when looking for SNEFRU) it might be necessary to have config
# files use ../../bin as part of the SRCH for this to work.
{
  __retval=0

  for __file
  do
    eval __cmdstr=\$$__file
    set X $__cmdstr
    __cmd=$2
    if [ ! -n "$__cmdstr" ]; then
      echo "--ERROR-- [init001e] Don't have required command $__file."
      __retval=1
    elif [ ! -f "$__cmd" ]; then
      echo "--ERROR-- [init004e] \`$__cmd' is not executable (command $__file)."
      __retval=1
    fi
  done
  return $__retval
}

haveallfiles()
{
  __retval=0

  for __var
  do
    eval __file=\$$__var
    if [ ! -n "$__file" ]; then
      echo "--ERROR-- [init005e] Don't have a value for file definition $__var."
      __retval=1
    elif [ ! -f "$__file" -a ! -d "$__file" ]; then
      echo "--ERROR-- [init006e] \`$__file' does not exist (file definition $__var)."
      __retval=1
    fi
  done

  return $__retval
}

haveallvars()
{
  __retval=0

  for __var
  do
    eval __val=\$$__var
    # Note: Probably checking if __val = "$" would be sufficient here
    # too.
    eval "echo \${$__var?error}" >/dev/null 2>&1
    [ $? -ne 0 ] && {
      echo "--ERROR-- [init007e] Don't have required variable $__var."
      __retval=1
    }
    if [ $__retval -eq 0 -a ! -n "$__val" ]
    then
      echo "--ERROR-- [init007e] Required variable $__var is empty."
      __retval=1
    fi
  done

  return $__retval
}

#
# Safe delete... will only delete files in $WORKDIR
#
delete()
{
  if [ -z "$RM" ] ; then
  	echo "--ERROR-- [init001e] The variable RM is not defined. Aborting."
	exit 1
  fi
  for __file
  do
	goahead=1
    if [ -n "$LS" ]
    then 
    	if [ -z "`$LS \"$__file\" 2>/dev/null`" ] 
	then
#       		echo "--ERROR-- [post001e] File \`$__file' will not be removed since it does not exist"
		goahead=0
	fi
    	if [ $goahead -eq 1 -a  -n "$AWK" -a -n "$UUID" ]
	then
	    	if [ "$UUID" != "`$LS -nl \"$__file\" | $AWK '{print $3}'`" ] 
		then
       			echo "--ERROR-- [post001e] File \`$__file' will not be removed since it has not been created by the current user (symlink attack?)."
			goahead=0
		fi
	fi
    fi
    [ $goahead -eq 1 ]  &&  {
    eval "case \"\$__file\" in
      $WORKDIR*) $RM -f \"\$__file\";;
      $LOGDIR*)  $RM -f \"\$__file\";;
      *) echo \"--ERROR-- [post001e] File \\\`\$__file' not removed.\";;
    esac"
    }
  done 2>/dev/null
}
#
# Determine if a message must be ignored. In order for this
# it uses the IGNORE_FILE defined 
# (in a similar way as logcheck does, using $EGREP -v -f )
#
ignore_message()
{
	__retval=1
  	__mesgcheck="$1"  
	[ -n "$IGNORE_FILE" ] && [ -f $IGNORE_FILE ] &&  \
	[ -z "`echo \"$__mesgcheck\" | $EGREP -v -f $IGNORE_FILE`" ] && __retval=0
	return $__retval
}
#
# Format a message...
#
# Escape stdin as the inside of a JSON string: quotes, backslashes, control
# characters, and every byte above 127 as \u00XX (one per byte, so a name
# in any encoding survives and the file is always plain ASCII). Lines are
# joined with \n.
json_escape()
{
  $AWK 'BEGIN { for (i = 1; i < 256; i++) ord[sprintf("%c", i)] = i }
        { if (NR > 1) printf "\\n"
          n = length($0)
          for (i = 1; i <= n; i++) {
            c = substr($0, i, 1); o = ord[c]
            if (c == "\\") printf "\\\\"
            else if (c == "\"") printf "\\\""
            else if (o < 32 || o > 126) printf "\\u%04x", o
            else printf "%s", c
          }
        }'
}

# Is this finding accepted? ACCEPT_FILE (tigris.accepted, managed by
# tigris-accept) has one entry per line: id, expiry (YYYY-MM-DD or -),
# message glob (or -), reason. Sets accepted_reason and accepted_until on
# a match that has not expired. Dates compare as YYYYMMDD numbers.
accepted_message()
{
  accepted_reason=; accepted_until=
  [ -n "$ACCEPT_FILE" ] && [ -f "$ACCEPT_FILE" ] || return 1
  __today=`$DATE +%Y%m%d 2>/dev/null`
  __tab=`printf '\t'`
  while IFS="$__tab" read __aid __auntil __aglob __areason
  do
    case "$__aid" in ''|\#*) continue ;; esac
    [ "$__aid" = "$1" ] || continue
    case "$__aglob" in ''|-) ;; *) case "$2" in $__aglob) ;; *) continue ;; esac ;; esac
    case "$__auntil" in
      ''|-) ;;
      *) __u=`echo "$__auntil" | $SED 's/-//g'`
         [ -n "$__today" ] && [ "$__u" -lt "$__today" ] 2>/dev/null && continue ;;
    esac
    accepted_reason=$__areason; accepted_until=$__auntil
    return 0
  done < "$ACCEPT_FILE"
  return 1
}

# One JSON Lines record per finding, when Tiger_JSON_File is set. Built in
# full first and written with one call, so checks running in parallel do
# not interleave. The category and controls come from meta/ID. INFO goes in regardless of Tiger_Show_INFO_Msgs: the
# JSON is for programs, which can filter for themselves.
json_record()
{
  [ -n "$Tiger_JSON_File" ] || return 0
  _jmsg=`printf '%s' "$4" | json_escape`
  _jline="{\"type\":\"finding\",\"level\":\"$1\",\"id\":\"$2\",\"check\":\"${0##*/}\",\"message\":\"$_jmsg\""
  [ -n "$3" ] && _jline="$_jline,\"detail\":\"`printf '%s' "$3" | json_escape`\""
  [ -n "$accepted_reason" ] && _jline="$_jline,\"accepted\":{\"reason\":\"`printf '%s' "$accepted_reason" | json_escape`\",\"until\":\"${accepted_until:--}\"}"
  # the category and the compliance controls from the finding's metadata
  # (meta/ID, doc/metadata.md, doc/controls.map), read in one pass: the
  # controls as {"cis_v8":[...],"nist_800_53":[...],...}
  case "$2" in
    ''|*[!a-z0-9]*) ;;
    *) [ -f "$BASEDIR/meta/$2" ] &&
         _jmeta=`$AWK '
           /^$/ { exit }
           /^Category: [a-z]+$/ { cat = substr($0, 11) }
           /^Controls: / {
             n = split(substr($0, 11), f, /; /)
             for (i = 1; i <= n; i++) {
               fw = f[i]; sub(/ .*/, "", fw); items = substr(f[i], length(fw) + 2)
               key = fw == "CIS" ? "cis_v8" : fw == "NIST" ? "nist_800_53" : fw == "ISO" ? "iso_27001_2022" : fw == "CE" ? "cyber_essentials" : ""
               if (key == "") continue
               m = split(items, it, /, /); l = ""
               for (j = 1; j <= m; j++) l = l (j > 1 ? "," : "") "\"" it[j] "\""
               ctl = ctl (ctl == "" ? "" : ",") "\"" key "\":[" l "]"
             }
           }
           END {
             if (cat != "") printf ",\"category\":\"%s\"", cat
             if (ctl != "") printf ",\"controls\":{%s}", ctl
           }' "$BASEDIR/meta/$2"` &&
         _jline="$_jline$_jmeta" ;;
  esac
  printf '%s}\n' "$_jline" >> "$Tiger_JSON_File"
}

message()
{
  _level="$1"
  _msgid="$2"
  _trail="$3"
  _mesg="$4"  
  __len=${Tiger_Output_Width:=79}

  # If the message should be ignore it is removed
  ignore_message "$_level $_msgid $_mesg" && return 

  # An accepted finding goes to the JSON, marked, and is counted, but not
  # to the text report
  if accepted_message "$_msgid" "$_mesg"; then
    json_record "$_level" "$_msgid" "$_trail" "$_mesg"
    accepted_reason=; accepted_until=
    [ -n "$Tiger_Accepted_Log" ] && echo "$_msgid" >> "$Tiger_Accepted_Log"
    return
  fi
  json_record "$_level" "$_msgid" "$_trail" "$_mesg"

  [ "$HTML" = "N" ] && {

  [ "$_level" = "INFO" -a "x$Tiger_Show_INFO_Msgs" = 'xN' ] && return

  {
    echo "$_mesg"
    [ -n "$_trail" ] && echo "$_trail"
  } |
  $AWK '
  BEGIN {
    printf("--%s-- [%s] ", "'"$_level"'", "'"$_msgid"'");
    vl = length("'"$_level"'") + 5;
    spaces="";
    for(i=0;i<vl;i++)
       spaces=spaces " ";
    ll = vl + length("'"$_msgid"'") + 3;
  }
  {
    if(ll==0){
      printf("%s", spaces);
      ll=vl;
    }
    for(i=1;i<=NF;i++){
      wl = length($i)+1;
      if('$__len' != 0 && (wl + ll) > '$__len'){
        printf("\n%s", spaces);
        ll = vl;
      }
      printf("%s ", $i);
      ll += wl;
    }
    printf("\n");
    ll=0;
  }
  '
}
 [ "$HTML" = "Y" ] && {
 [ "$_level" = "INFO" -a "x$Tiger_Show_INFO_Msgs" = 'xN' ] && return
  {
    echo "$_mesg"
    [ -n "$_trail" ] && echo "$_trail"
  } |
  $AWK '
  BEGIN {
      printf("</PRE><LI><B><I>%s</I></B> <A HREF=\"#%s\">[%s]</A>", "'"$_level"'", "'"$_msgid"'", "'"$_msgid"'");
    vl = length("'"$_level"'") + 5;
    spaces="";
    for(i=0;i<vl;i++)
       spaces=spaces " ";
    ll = vl + length("'"$_msgid"'") + 3;
  }
  {
    if(ll==0){
      printf("%s", spaces);
      ll=vl;
    }
    for(i=1;i<=NF;i++){
      wl = length($i)+1;
      if('$__len' != 0 && (wl + ll) > '$__len'){
        printf("\n%s", spaces);
        ll = vl;
      }
      printf("%s ", $i);
      ll += wl;
    }
    printf("<PRE>\n");
    ll=0;
  }
 '
}
}
#
#  Output messages about a file... reads the output of lgetpermit()
#
#  $1 and $2 are the ids for "not owned by" and "writable by" without
#  their last letter, which is the level's: an id names one level, as the
#  JSON schema requires. $1 is reported as WARN or INFO, $2 as FAIL, WARN
#  or INFO, so each has a meta file per letter (ali003w and ali003i).
#
pathmsg()
{
  __omsgid="$1"
  __amsgid="$2"
  __path="$3"
  __owner="$4"
  __msgtxt="$5"
  __trailer="$6"

  __dir=0
  __phere=`__here "$__path"`
  [ -d "$__phere" ] && __dir=1
  
  __exec=0
  [ -f "$__phere" ] && {	
    set X `getpermit "$__path"`
    shift 4

    [ "$3$6$9" != '000' ] && __exec=1
  }
  
  while read __comp __rowner __group ur uw ux gr gw gx or ow ox suid sgid stk
  do
    __omsg=''
    [ "$__owner" != '.' ] && {
      case "$__owner" in
	root) {
	  [ "$__owner" != "$__rowner" ] && {
	    __omsg="not owned by $__owner (owned by $__rowner)."
	    __olvl='WARN'
	    [ $__dir -eq 1 -o $__exec -eq 0 ] && __olvl='INFO'
	  }
	}
        ;;
	*) {
	  [ "$__owner" != "$__rowner" ] && {
	    __omsg="not owned by $__owner (owned by $__rowner)."
	    __olvl='WARN'
	    case "$__rowner" in
	      root|bin) __omsg='';;
	    esac
	  }
	}
        ;;
      esac
    }

    __file="\`$__path'"
    [ "$__path" != "$__comp" ] && {
      __file="\`$__path' which contains \`$__comp'"
    }

    # A sticky directory above the path (/tmp) lets others add entries but
    # not replace one they do not own, so its write bits do not matter
    [ "$stk" = 1 ] && [ "$__path" != "$__comp" ] && [ -d "`__here "$__comp"`" ] && { gw=0; ow=0; }

    case "$gw$ow" in
      00) __access='';;
      01) {
	__access='world'
	__alvl='FAIL'
	[ $__dir -eq 1 -o $__exec -eq 0 ] && __alvl='INFO'
	__newmode='o-w'
      }
      ;;
      10) {
	__access="group \`$__group'"
	__alvl='WARN'
	[ $__dir -eq 1 -o $__exec -eq 0 ] && {
	  case "$__owner" in
	    root) __alvl='INFO';;
	    *) __access='';;
	  esac
	}
	__newmode='g-w'
      }
      ;;
      11) {
	__access="group \`$__group' and world"
	__alvl='FAIL'
	[ $__dir -eq 1 -o $__exec -eq 0 ] && __alvl='INFO'
	__newmode='go-w'
      }
      ;;
      *) __access='';;
    esac
    
    [ -n "$__omsg" ] && {
      case "$__olvl" in WARN) __l=w ;; *) __l=i ;; esac
      message "$__olvl" "$__omsgid$__l" "$__trailer" "$__msgtxt $__file which is $__omsg"
      echo
      changelog "$__olvl : chown : $__owner : $__comp"
    }
    
    [ -n "$__access" ] && {
      case "$__alvl" in FAIL) __l=f ;; WARN) __l=w ;; *) __l=i ;; esac
      message "$__alvl" "$__amsgid$__l" "$__trailer" "$__msgtxt $__file which is $__access writable."
      echo
      changelog "$__alvl : chmod : $__newmode : $__comp"
    }
  done
}
#
# Generate 0's and 1's to indicate the user, group and other read, write,
# and execute permissions on a given file.
#
__getpermit()
{
  (
    if [ -n "$1" ]; then
      for file
      do
	$LS $LSLINK $LSGROUP -ld "$file" 2> /dev/null
      done
    else
      while read file
      do
	$LS $LSLINK $LSGROUP -ld "$file" 2> /dev/null
      done
    fi
  ) |
   $AWK '
    {
      printf("%s %s %s ", $NF, $3, $4);
      for(i=2;i<11;i++){
        c = substr($1, i, 1);
        if(c != "-" && c != "S" && c != "T"){
	   printf("1 ");
	}
        else {
	   printf("0 ");
        }
      }
      if(substr($1, 4, 1) == "s" || substr($1, 4, 1) == "S")
        printf("1 ");
      else
        printf("0 ");
      if(substr($1, 7, 1) == "s" || substr($1, 4, 1) == "S")
        printf("1 ");
      else
        printf("0 ");
      if(substr($1, 10, 1) == "t" || substr($1, 10, 1) == "T")
        printf("1 ");
      else
        printf("0 ");
      printf("\n");
   }'
}

# __rootpermit: getpermit for an offline root (--root). The paths are the
# audited system's, given as arguments or one a line; each is resolved
# inside the root, and its owner and group are named from that system's
# passwd and group files, not this host's. The path printed is the one
# given, so messages name the system's own paths.
__rootpermit()
{
  __rootpw=`rootfile /etc/passwd`
  __rootgr=`rootfile /etc/group`
  if [ -n "$1" ]; then printf '%s\n' "$@"; else cat; fi |
  while IFS= read -r __rp
  do
    __rh=`rootfile "$__rp"`
    [ -n "$__rh" ] && printf '%s\t%s\n' "$__rp" "`$LS -ldn \"$__rh\" 2>/dev/null`"
  done |
  $AWK -F'\t' -v pw="$__rootpw" -v gr="$__rootgr" '
    BEGIN {
      while ((getline l < pw) > 0) { split(l, f, ":"); if (!(f[3] in u)) u[f[3]] = f[1] }
      while ((getline l < gr) > 0) { split(l, f, ":"); if (!(f[3] in g)) g[f[3]] = f[1] }
    }
    {
      if (split($2, a, " ") < 4) next
      printf("%s %s %s ", $1, (a[3] in u) ? u[a[3]] : a[3], (a[4] in g) ? g[a[4]] : a[4])
      for (i = 2; i < 11; i++) {
        c = substr(a[1], i, 1)
        printf("%s ", (c != "-" && c != "S" && c != "T") ? 1 : 0)
      }
      printf("%s ", (substr(a[1], 4, 1) == "s" || substr(a[1], 4, 1) == "S") ? 1 : 0)
      printf("%s ", (substr(a[1], 7, 1) == "s" || substr(a[1], 4, 1) == "S") ? 1 : 0)
      printf("%s \n", (substr(a[1], 10, 1) == "t" || substr(a[1], 10, 1) == "T") ? 1 : 0)
    }'
}

getpermit()
{
  [ -n "$TIGRIS_ROOT" ] && { __rootpermit "$@"; return; }
  gp="$GETPERMIT"
  [ ! -n "$gp" ] && gp="__getpermit"
  if [ -n "$1" ]; then
    $gp "$1" 2>/dev/null
  else
    $gp 2>/dev/null
  fi
}

#
# Generate output lines of the form:
#
# pathname owner group ur uw ux gr gw gx or ow ox sticky suid sgid
#
# for every component of a filename.  If 'realpath' is "active",
# then symbolic links will be resolved and all components of the
# target will also be included in the output.
#
#---
# This definition should be overridden in the scripts including
# this file.  This is just for safety.
[ ! -n "$realpath" ] && realpath=echo
#
lgetpermit()
{
  _file="$1"
  _saveifs=$IFS
  # Offline, the components are the audited system's paths, each resolved
  # inside the root by getpermit: this host's realpath would follow links
  # out of it
  if [ -n "$TIGRIS_ROOT" ]; then
    __decomp=$_file
  else
    __decomp="`$realpath \"$_file\"`"
  fi

  for __acomp in $__decomp
  do
    if [ "$__acomp" != '/' ]; then
      IFS=/
      set $__acomp
      IFS=$_saveifs
      _path=
    else
      _path=/
      set ""
    fi

    for _comp
    do
      [ -n "$_comp" ] && {
	_path="$_path/$_comp"
	echo "$_path"
      }
    done
  done |
  getpermit
}
#
# Write entry to change log
#
changelog()
{
  _msgtxt="$*"
  [ -n "$TigerChangeLog" ] && echo "$_msgtxt" >> $TigerChangeLog
}

#
# Generic cleanup routine.
# It will clean all the files available in the TigerCleanup variable
# scripts can either use this or define their own cleanup routine.
#
cleanup()
{
  [ "$_TIGER_RUN" != 'Y' -a -n "$TigerCleanup" ] && {
    delete $TigerCleanup
  }
}

#
# Given a temporary file determines if it exists
# if it does bails out since it shouldn't be there
#
# mount_alive PATH: 0 unless the filesystem under PATH does not answer.
#
# A hard NFS or CIFS mount whose server is down blocks every program that
# touches a path under it, and the check that touched it would never
# finish. df -P asks the filesystem itself (statfs) and runs under a kill
# timeout (Tiger_Mount_Timeout, seconds); only the kill means "dead". A
# path that does not exist, or a df that cannot run, is left for the
# caller's own tests. Without a timeout command there is no probe, as
# before. A parent directory found dead is remembered, so a hundred home
# directories on one dead server cost one timeout, not a hundred.
# Tiger_Mount_Probe_Cmd replaces df for the tests.
#
mount_alive()
{
  # an offline root's mounts are not this host's to probe
  [ -n "$TIGRIS_ROOT" ] && return 0
  [ -n "$TIMEOUT" ] || return 0
  __probe=${Tiger_Mount_Probe_Cmd:-$DF}
  [ -n "$__probe" ] || return 0
  __dir=${1%/*}
  [ -n "$__dir" ] || __dir=/
  case "|$__dead_dirs|" in *"|$__dir|"*) return 1 ;; esac
  $TIMEOUT -s KILL "${Tiger_Mount_Timeout:-5}" "$__probe" -P "$1" >/dev/null 2>&1
  case $? in
    124|137) __dead_dirs="$__dead_dirs|$__dir"; return 1 ;;
  esac
  return 0
}

safe_temp()
{
  for __tmpfile
  do
    if [ -f "$__tmpfile" ] ; then
        echo  "--ERROR-- [init009e] Tempfile \`$__tmpfile' exists."
        exit 1
    else
        >$__tmpfile
    fi
  done
}
#
# rootpaths: for each path of the audited system on standard input (as
# /etc/pam.d/login), where it is on this host. On the running system that
# is the path itself; auditing an offline root (--root) it is resolved
# inside the root by util/rootpath, symbolic links followed the way that
# system would follow them, so that nothing outside the root is read.
# The tests' Tiger_Sysctl_Root is such a root too.
# rootfile PATH: the same for one path.
# rootls DIR: the entries of the audited system's DIR, as its paths.
rootpaths()
{
  if [ -n "$TIGRIS_ROOT$Tiger_Sysctl_Root" ]; then
    AWK=$AWK sh $BASEDIR/util/rootpath "${TIGRIS_ROOT:-$Tiger_Sysctl_Root}" "$TIGRIS_LINKS"
  else
    cat
  fi
}
rootfile()
{
  printf '%s\n' "$1" | rootpaths
}
# __here PATH: where PATH of the audited system is on this host: itself on
# the running system, resolved inside the root when auditing an offline
# one. Unlike rootfile it never prefixes the tests' Tiger_Sysctl_Root, so
# the old checks that call it behave as they always have on a live system.
__here()
{
  if [ -n "$TIGRIS_ROOT" ]; then rootfile "$1"; else printf '%s\n' "$1"; fi
}
rootls()
{
  __rdir=`rootfile "$1"`
  for __rent in "$__rdir"/* "$__rdir"/.[!.]*
  do
    [ -e "$__rent" ] || [ -L "$__rent" ] && printf '%s\n' "${1%/}/${__rent##*/}"
  done
}

# lsline PATH: PATH as "ls -ld" shows it, for a report. On an offline root
# the file is the root's (resolved inside it), its owner and group are
# named from the root's passwd and group files, and the path shown is the
# root's own, not where it is on this host.
lsline()
{
  if [ -z "$TIGRIS_ROOT" ]; then
    $LS $LSGROUP -ld "$1"
    return
  fi
  __h=`rootfile "$1"`
  [ -n "$__h" ] || return 0
  LC_ALL=C $LS -ldn "$__h" 2>/dev/null |
  $AWK -v pw="`rootfile /etc/passwd`" -v gr="`rootfile /etc/group`" -v hp="$__h" -v ip="$1" '
    BEGIN {
      while ((getline l < pw) > 0) { split(l, x, ":"); if (!(x[3] in u)) u[x[3]] = x[1] }
      while ((getline l < gr) > 0) { split(l, x, ":"); if (!(x[3] in g)) g[x[3]] = x[1] }
    }
    {
      i = index($0, hp)
      head = i ? substr($0, 1, i - 1) : $0
      tail = i ? substr($0, i + length(hp)) : ""
      n = split(head, f, " ")
      if (f[3] in u) f[3] = u[f[3]]
      if (f[4] in g) f[4] = g[f[4]]
      out = f[1]; for (k = 2; k <= n; k++) out = out " " f[k]
      print out " " ip tail
    }'
}

# sysctl_configured: the kernel settings the system audited applies at
# boot, "key<TAB>value<TAB>file" in the order they are applied (the last of
# a key wins), as systemd-sysctl applies them: the *.conf files of
# /etc/sysctl.d, /run/sysctl.d, /usr/local/lib/sysctl.d, /usr/lib/sysctl.d
# and /lib/sysctl.d, one of a name (the first of those directories that
# has it), in the order of their names; then /etc/sysctl.conf, as procps'
# sysctl --system reads it, unless one of those files is a link to it.
# Keys written with / are given with dots; a key may be a glob. For an
# offline root, where /proc/sys is not that system's.
sysctl_configured()
{
  __main=`rootfile /etc/sysctl.conf`
  safe_temp $WORKDIR/sysctl.files.$$
  {
    for __d in /etc/sysctl.d /run/sysctl.d /usr/local/lib/sysctl.d /usr/lib/sysctl.d /lib/sysctl.d
    do
      rootls $__d
    done | $AWK '/\.conf$/ { n = $0; sub(/.*\//, "", n); if (!(n in seen)) { seen[n]; print n "\t" $0 } }' |
      $SORT | $AWK -F'\t' '{ print $2 }'
  } | while IFS= read -r __f
  do
    __h=`rootfile "$__f"`
    [ "$__h" = "$__main" ] && __main=
    printf '%s\t%s\n' "$__f" "$__h"
  done > $WORKDIR/sysctl.files.$$
  [ -n "$__main" ] && [ -f "$__main" ] && printf '/etc/sysctl.conf\t%s\n' "$__main" >> $WORKDIR/sysctl.files.$$
  while IFS='	' read -r __f __h
  do
    [ -f "$__h" ] || continue
    $AWK -v src="$__f" '
      { sub(/^[ \t]+/, "") }
      /^[#;]/ || !/=/ { next }
      {
        k = $0; sub(/[ \t]*=.*/, "", k); sub(/^-/, "", k); gsub(/\//, ".", k)
        v = $0; sub(/^[^=]*=[ \t]*/, "", v); sub(/[ \t]+$/, "", v)
        if (k != "") printf "%s\t%s\t%s\n", k, v, src
      }' "$__h"
  done < $WORKDIR/sysctl.files.$$
  delete $WORKDIR/sysctl.files.$$
}

# sysctl_value KEY: the value an offline root sets KEY to at boot, and the
# file that sets it, "value<TAB>file"; nothing when nothing sets it. Reads
# what sysctl_configured wrote to $SYSCTL_CONF.
sysctl_value()
{
  $AWK -F'\t' -v key="$1" '
    {
      p = $1
      gsub(/\./, "\\.", p); gsub(/\*/, ".*", p); gsub(/\?/, ".", p)
      if (key ~ ("^" p "$")) { v = $2; f = $3 }
    }
    END { if (f != "") printf "%s\t%s\n", v, f }' "$SYSCTL_CONF"
}

# skip_check SCRIPT: whether a check runs here, from what its header says.
# When it does not, a "# Skipped" line goes in the report and a skip record
# in the JSON, and it returns 0.
#  - Auditing an offline root (--root, TIGRIS_ROOT): only a check that says
#    "# Tigris: offline" reads everything under that root; one that says
#    "# Tigris: live system" needs the running system (its processes,
#    kernel, firmware); any other cannot read an offline root yet.
#  - Not running as root: a check that says "# Tigris: needs root" cannot
#    give a true answer (it would report what it could not read as missing
#    or changed). The exit status counts it as a check that could not run.
skip_check()
{
  __sname=${1##*/}
  if [ -n "$TIGRIS_ROOT" ] && ! $GREP -q '^# Tigris: offline$' "$1" 2>/dev/null; then
    if $GREP -q '^# Tigris: live system$' "$1" 2>/dev/null; then
      __why="live system" __text="it reads the running system, and this audit is of $TIGRIS_ROOT"
    else
      __why="not offline yet" __text="it cannot read an offline root yet"
    fi
  elif [ "$UUID" != 0 ] && $GREP -q '^# Tigris: needs root$' "$1" 2>/dev/null; then
    __why="needs root" __text="it needs root, and Tigris is not running as root"
  else
    return 1
  fi
  echo "# Skipped $__sname: $__text."
  [ -n "$Tiger_JSON_File" ] && printf '{"type":"skip","check":"%s","reason":"%s"}\n' "$__sname" "$__why" >> "$Tiger_JSON_File"
  return 0
}

#
# Run_script() function
# This function will run a script first looking for it in the most
# specific directories (those belonging to a given operating system
# release, revision and architecture) and to the most generic
# (the 'default' system and the scripts directory) afterwards.
# It will also check that the script is owned by the same user running
# the program and wether or not it is executable.
#
run_script()
{
  __script_run=""
  __error=0
  for __script
  do
	for dir in $BASEDIR/systems/default $SCRIPTDIR 
        do
	  if [ -f "$dir/$__script" ] ; then
            __script_run="$dir/$__script"
          fi
        done
	for dir in $OS $OS/$REL $OS/$REL/$REV $OS/$REL/$REV/$ARCH 
	do
	  if [ -f "$BASEDIR/systems/$dir/$__script" ] ; then
            __script_run="$BASEDIR/systems/$dir/$__script"
          fi
	done
#	echo "Script is $__script_run"
	if [ "$__script_run" != "" ] ; then
            __script_owner=`$LS -nl $__script_run | $AWK '{ print $3; }'`
            if test $TESTEXEC $__script_run; then
	            # The owner may run it, and so may the same person via sudo
	            if [ $__script_owner -eq $UUID ] || [ "$__script_owner" = "${SUDO_UID:-}" ]; then
			skip_check "$__script_run" || $__script_run
		    else
			message ERROR misc024e "" "The $__script_run script will not be run since it is owned by a user ($__script_owner) different than the one running Tiger ($UUID)"
  			__error=1
		    fi
	    else
          	message ERROR misc025e "" "The $__script_run will not be run since it is not executable"
                __error=1
            fi
        else
          message ERROR misc005e "" "Can't find '$__script'..."
          __error=1
        fi
  done
  return $__error
}


trap cleanup 0
