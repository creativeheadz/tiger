#
# tigris explain ID...: what a finding means (meta/ID), through tigexp
case "$1" in
  explain) shift; exec sh "`dirname "$0"`/tigexp" "$@" ;;
esac

# The banner comes before config reads the options, so -q is looked for here
case " $* " in
  *" -q "*) ;;
  *)
echo "Tigris security checking system"
echo "   Based on Tiger, developed by Texas A&M University, 1993-1994"
echo "   Updated by the Advanced Research Corporation, 1999-2002"
echo "   Maintained by Javier Fernandez-Sanguino, 2001-2019"
echo "   Contributions by Francisco Manuel Garcia Claramonte, 2009-2010"
echo "   Continued as Tigris by Andrei Trimbitas, 2026"
echo "   Covered by the GNU General Public License (GPL)"
echo
  ;;
esac
TigerInstallDir="."
#
# Set default base directory.
# Order or preference:
#      -B option
#      TIGERHOMEDIR environment variable
#      TigerInstallDir installed location
#
basedir=${TIGERHOMEDIR:=$TigerInstallDir}

for parm
do
   case $parm in
   -B) basedir=$2; break;;
   esac
done

#
# Verify that a config file exists there, and if it does
# source it.
#
[ ! -r $basedir/config ] && {
  echo "--ERROR-- [init002e] No 'config' file in \`$basedir'."
  exit 1
}

# config pins the locale to C for deterministic tools; remember what the
# terminal had, for the spinner frames
Tiger_Orig_Locale="${LC_ALL:-${LANG:-}}"

. $basedir/config

. $BASEDIR/initdefs

sendtologger()
{
  file=$1
  if [ -r "$file" ]; then
  	echo "Cannot read report in $file to send to syslog"
	exit 1
  fi
  logger_port="5353"
  logger_name=`echo $LOGDIR | $AWK -F\@ '{print $2}'`
  safe_temp $WORKDIR/logger.$$
  TigerCleanup="$TigerCleanup $WORKDIR/logger.$$"
  echo "sleep 5; cat $logfile; sleep 5" >$WORKDIR/logger.$$
  sh $WORKDIR/logger.$$ | telnet $logger_name $logger_port
  if [ "$?" -ne 0 ]; then
   echo "TIGER logger server [$logger_name] is not available"
   delete $WORKDIR/logger.$$
   exit 1
  fi
  delete $WORKDIR/logger.$$
  # Do not proceed since the LOGDIR value would be useless for us
  # TODO: Consider use a -s switch to define logging to syslog
  # so that logs are always kept locally too
  exit 0
}

tigercleanup()
{
  spin_stop
  [ -n "$fspid" ] && kill -1 $fspid 2>/dev/null
  [ -f "$Tiger_PasswdFiles" ] && {
    while read __file
    do
      delete $__file $__file.src
    done < $Tiger_PasswdFiles
  }
  [ -n "$TigerCheckEmbedded" ] && delete $TigerCheckEmbedded
  delete $WORKDIR/fsscan.log$$ $Tiger_PasswdFiles

  [ -n "$TigerCleanup" ] && {
    delete $TigerCleanup
  }  
}

trap 'tigercleanup; exit 1' 1 2 3 15

#
# If run in test mode (-t) this will verify that all required
# elements are set.
#
[ "$Tiger_TESTMODE" = 'Y' ] && {
  haveallcmds CAT DATE DATECMD GEN_PASSWD_SETS GREP MV RM TIMECMD || exit 1
  haveallfiles BASEDIR SCRIPTDIR WORKDIR CONFIG_DIR LOGDIR || exit 1
  haveallvars HOSTNAME OS REL REV ARCH || exit 1
  
  echo "--CONFIG-- [init003c] $0: Configuration ok..."
  exit 0
}

#------------------------------------------------------------------------

haveallcmds CAT DATE DATECMD GEN_PASSWD_SETS GREP MV RM TIMECMD || exit 1
haveallfiles BASEDIR SCRIPTDIR CONFIG_DIR LOGDIR WORKDIR || exit 1

#
# Check scripts owned by another user are never run (misc024e). When Tiger
# runs as root from a tree owned by someone else that skips every check, so
# say so once, up front, instead of producing an empty report.
#
# A tree owned by the person who ran sudo is theirs to run: no privilege
# boundary is crossed, so a developer's own checkout works without a chown.
[ "$UUID" = 0 ] && {
  scripts_owner=`$LS -nd $SCRIPTDIR | $AWK '{ print $3; }'`
  [ "$scripts_owner" != 0 ] && [ "$scripts_owner" != "${SUDO_UID:-0}" ] && {
    echo "--ERROR-- [init010e] Tiger is running as root but \`$SCRIPTDIR' is owned by uid $scripts_owner, so its check scripts would not be run. Run it with sudo as that user, or make the tree root's: chown -R root:root $BASEDIR"
    exit 1
  }
}
haveallvars HOSTNAME OS REL REV ARCH || exit 1

#
# --since: the run to compare with is settled before this one starts, so
# the new report can never be its own baseline. With 'last' and no earlier
# run, since_file stays empty and every finding counts as new.
#
since_file=
[ -n "$SINCE_RUN" ] && {
  [ "$Tiger_Output_JSON" = 'N' ] && {
    echo "--ERROR-- [init011e] --since compares JSON reports, and Tiger_Output_JSON is N in $RCFILE."
    exit 1
  }
  if [ "$SINCE_RUN" = 'last' ]; then
    # newest last, by name: the date stamp sorts
    since_file=`$LS "$LOGDIR"/security.report."$HOSTNAME".*.jsonl 2>/dev/null | $SORT | $TAIL -1`
  else
    since_file=$SINCE_RUN
    [ -r "$since_file" ] || {
      echo "--ERROR-- [init012e] Cannot read $since_file, the run to compare with."
      exit 1
    }
  fi
}

# -q: nothing on the terminal while the checks run. What --since finds is
# printed at the end, through the descriptor kept here.
[ "$QUIET" = 'Y' ] && exec 3>&1 >/dev/null

version="$TIGERVERSION"

echo "Tiger security scripts *** $version ***"

[ "$Tiger_TESTMODE" != 'Y' ] && {
  # Seconds in the stamp, so two runs started in the same minute get
  # different report names instead of overwriting each other.
  datestamp="`$DATECMD`-`$TIMECMD`"

  logtmp="$LOGDIR/security.report.${HOSTNAME}.tmp.$$"
  logfile="$LOGDIR/security.report.${HOSTNAME}.$datestamp"
  expreport="$LOGDIR/explain.report.${HOSTNAME}.$datestamp"
}

> $logtmp

[ "$Tiger_TESTMODE" != 'Y' ] && {

  echo "Security scripts *** $version ***" >> $logtmp
  [ "$HTML" = "Y" ] && {
  	echo '<H2><CENTER>TIGER System Security Scanner</H2></Center>' > $logtmp
  	echo '<PRE>' >> $logtmp
        echo "Tiger security scripts *** $version ***" >> $logtmp
        echo "Output Mode is HTML"
        echo "HTML Generator developed by the Advanced Research Corporation (R)" >> $logtmp
  }
  


  $DATE >> $logtmp
  echo "`$TIMECMD`> Beginning security report for ${HOSTNAME} ($ARCH $OS $REV)." >> $logtmp
  echo "`$TIMECMD`> Beginning security report for ${HOSTNAME}."
  [ -n "$TIGRIS_ROOT" ] && {
    echo "# Auditing the system in $TIGRIS_ROOT, which is not running: its files are read from ${HOSTNAME}, with ${HOSTNAME}'s tools, and checks of a running system are skipped." >> $logtmp
    echo "`$TIMECMD`> Auditing the system in $TIGRIS_ROOT, which is not running."
  }
  # The same findings as JSON Lines, next to the text report
  [ "$Tiger_Output_JSON" != 'N' ] && {
    Tiger_JSON_File="$LOGDIR/security.report.${HOSTNAME}.$datestamp.jsonl"
    export Tiger_JSON_File
    # An id for this run, so its records can be told from another run's
    Tiger_Run_Id=`$CAT /proc/sys/kernel/random/uuid 2>/dev/null`
    [ -n "$Tiger_Run_Id" ] || Tiger_Run_Id="${HOSTNAME}-${datestamp}-$$"
    export Tiger_Run_Id
    # Whether the filesystem scan runs: a run without it has no fsys*
    # findings, which tigris-diff must not read as "resolved"
    fsscan=true
    [ "$Tiger_Check_FILESYSTEM" = 'N' ] && fsscan=false
    # the profile (--profile) applied on top of the tigerrc, when one was
    profile=
    [ -n "$PROFILE" ] && profile=",\"profile\":\"$PROFILE\""
    # the directory audited instead of the running system (--root)
    [ -n "$TIGRIS_ROOT" ] && profile="$profile,\"root\":\"`printf '%s' "$TIGRIS_ROOT" | json_escape`\""
    echo "{\"type\":\"run\",\"schema\":1,\"id\":\"$Tiger_Run_Id\",\"tool\":\"tigris\",\"version\":\"$version\",\"host\":\"$HOSTNAME\",\"os\":\"$OS\",\"release\":\"$REV\",\"arch\":\"$ARCH\",\"config\":\"$RCFILE\"$profile,\"filesystem_scan\":$fsscan,\"start\":\"`$DATE -u +%Y-%m-%dT%H:%M:%SZ`\"}" > $Tiger_JSON_File
  }
}

_TIGER_RUN=Y
export _TIGER_RUN
Tiger_Accepted_Log=$WORKDIR/accepted.$$
export Tiger_Accepted_Log
: > $Tiger_Accepted_Log
OUTPUTMETHOD="$CAT"

Tiger_PasswdFiles=$WORKDIR/passwd.list.$$
export Tiger_PasswdFiles

[ "$Tiger_Check_EMBEDDED" != 'N' ] && {
  TigerCheckEmbedded="$WORKDIR/embed.list.$$"
  > $TigerCheckEmbedded
}
export TigerCheckEmbedded

[ "$Tiger_TESTMODE" != 'Y' ] && {
  delete $Tiger_PasswdFiles
  $GEN_PASSWD_SETS $Tiger_PasswdFiles
}

# Say so when the scan is off, so that no fsys* findings is not read as a
# clean file system (the quick profile turns it off)
[ "$Tiger_Check_FILESYSTEM" = 'N' ] && [ "$Tiger_TESTMODE" != 'Y' ] && {
  echo "`$TIMECMD`> Filesystem scan not run (Tiger_Check_FILESYSTEM=N in $RCFILE)."
  echo "# Filesystem scan not run (Tiger_Check_FILESYSTEM=N in $RCFILE): setuid, device, symlink, unowned and odd-name findings (fsys*) are absent because they were not looked for, not because there are none." >> $logtmp
}

# Auditing an offline root: its symbolic links, listed once for every
# check's rootfile and rootpaths (util/rootpath), before any check runs
[ -n "$TIGRIS_ROOT" ] && {
  TIGRIS_LINKS=$WORKDIR/rootlinks.$$
  TigerCleanup="$TigerCleanup $TIGRIS_LINKS"
  safe_temp $TIGRIS_LINKS
  sh $BASEDIR/util/rootpath "$TIGRIS_ROOT" "$TIGRIS_LINKS" < /dev/null
  export TIGRIS_LINKS
}

[ "$Tiger_Check_FILESYSTEM" != 'N' ] && {
  if [ "$Tiger_TESTMODE" = 'Y' ]; then
    progress_start "Performing file systems scans..."
    run_script find_files >> $logtmp
    progress_end
  else
    echo "`$TIMECMD`> Starting file systems scans in background..."
    skip_check $SCRIPTDIR/find_files >> $logtmp || {
      $SCRIPTDIR/find_files > $WORKDIR/fsscan.log$$ 2>/dev/null &
      fspid=$!
    }
  fi
}

crackpid=
[ "$Tiger_Run_CRACK" != 'N' ] && {
  if [ "$Tiger_TESTMODE" = 'Y' ]; then
    progress_start "Running Crack (password cracker)..."
    run_script crack_run
    progress_end
  else
    crackout=$WORKDIR/crack.out.$$
    echo "`$TIMECMD`> Running Crack (password cracker) in background..."
    skip_check $SCRIPTDIR/crack_run >> $logtmp || {
      nice -6 $SCRIPTDIR/crack_run > $crackout &
      crackpid=$!
    }
  fi
}

trippid=
[ "$Tiger_Run_TRIPW" != 'N' ] && {
  if [ "$Tiger_TESTMODE" = 'Y' ]; then
    progress_start "Running Tripwire..."
    run_script tripwire_run
    progress_end
  else
    tripout=$WORKDIR/tripwire.out.$$
    echo "`$TIMECMD`> Running Tripwire in background..."
    skip_check $SCRIPTDIR/tripwire_run >> $logtmp || {
      nice -6 $SCRIPTDIR/tripwire_run > $tripout &
      trippid=$!
    }
  fi
}

aidepid=
[ "$Tiger_Run_AIDE" != 'N' ] && {
  if [ "$Tiger_TESTMODE" = 'Y' ]; then
    progress_start "Running Aide..."
    run_script aide_run
    progress_end
  else
    export aideout=$WORKDIR/aide.out.$$
    echo "`$TIMECMD`> Running Aide in background..."
    skip_check $SCRIPTDIR/aide_run >> $logtmp || {
      nice -6 $SCRIPTDIR/aide_run > $aideout &
      aidepid=$!
    }
  fi
}


[ "$Tiger_Check_PASSWD" != 'N' ] && {
  progress_start "Checking password files..."
  run_script check_passwd >> $logtmp
  progress_end
}

# The password files' format: off by default, since pwck says the same;
# on an offline root pwck is not run (it would read this host's files),
# so it comes on with the passwd check
[ "$Tiger_Check_PASSWD_FORMAT" != 'N' ] || { [ -n "$TIGRIS_ROOT" ] && [ "$Tiger_Check_PASSWD" != 'N' ]; } && {
  progress_start "Checking password format..."
  run_script check_passwdformat >> $logtmp
  progress_end
}

[ "$Tiger_Check_GROUP" != 'N' ] && {
  progress_start "Checking group files..."
  run_script check_group >> $logtmp
  progress_end
}

[ "$Tiger_Check_ACCOUNTS" != 'N' ] && {
  progress_start "Checking user accounts..."
  run_script check_accounts >> $logtmp
  progress_end
}

# Note: TARA calls this script with Tiger_Check_ROOT so we keep it
# there for compatibility purposes
[ \( "$Tiger_Check_ROOT" != 'N' -a -n "$Tiger_Check_ROOT" \) -o "$Tiger_Check_ROOT_ACCESS" != 'N' ] && {
  progress_start "Checking ttytab, securetty, and login configuration files..."
  run_script check_root >> $logtmp
  progress_end
}


[ "$Tiger_Check_PATH" != 'N' ] && {
  progress_start "Checking PATH settings..."
  run_script check_path >> $logtmp
  progress_end
}

[ "$Tiger_Check_ALIASES" != 'N' ] && {
  progress_start "Checking mail aliases..."
  run_script check_aliases >> $logtmp
  progress_end
}

[ "$Tiger_Check_CRON" != 'N' ] && {
  progress_start "Checking cron entries..."
  run_script check_crontabs >> $logtmp
  progress_end
}

[ "$Tiger_Check_SERVICES" != 'N' ] && {
  progress_start "Checking 'services' configuration..."
  run_script check_services >> $logtmp
  progress_end
}

[ "$Tiger_Check_EXPORTS" != 'N' ] && {
  progress_start "Checking NFS export entries..."
  run_script check_exports >> $logtmp
  progress_end
}

[ "$Tiger_Check_NFSD" != 'N' ] && {
  progress_start "Checking NFS daemons against exports..."
  run_script check_nfsd >> $logtmp
  progress_end
}

[ "$Tiger_Check_PERMS" != 'N' ] && {
  progress_start "Checking permissions and ownership of system files..."
  run_script check_perms >> $logtmp
  progress_end
}

[ "$Tiger_Check_SIGNATURES" != 'N' ] && {
  progress_start "Checking for altered or out of date binaries..."
  run_script check_signatures >> $logtmp
  progress_end
}

[ "$Tiger_Check_KNOWN" != 'N' ] && {
  progress_start "Checking for indications of break-in..."
  run_script check_known >> $logtmp
  progress_end
}

[ "$Tiger_Check_ROOTKIT" != 'N' ] && {
  progress_start "Performing rootkit checks..."
  run_script check_rootkit >> $logtmp
  progress_end
}

[ "$Tiger_Check_SYSTEM" != 'N' ] && {
  progress_start "Performing system specific checks..."
  run_script check_system >> $logtmp
  progress_end
}


[ "$Tiger_Check_ROOTDIR" != 'N' ] && {
  progress_start "Performing root directory checks..."
  run_script check_rootdir >> $logtmp
  progress_end
}

[ "$Tiger_Check_ETCISSUE" != 'N' ] && {
  progress_start "Performing /etc/issue login banner checks..."
  run_script check_issue >> $logtmp
  progress_end
}


[ "$Tiger_Check_BACKUPS" != 'N' ] && {
  progress_start "Checking for secure backup devices..."
  run_script check_devices >> $logtmp
  progress_end
}


[ "$Tiger_Check_LOGFILES" != 'N' ] && {
  progress_start "Checking for the presence of log files..."
  run_script check_logfiles >> $logtmp
  progress_end
}

[ "$Tiger_Check_USERUMASK" != 'N' ] && {
  progress_start "Checking for the setting of user's umask..."
  run_script check_umask >> $logtmp
  progress_end
}

#
# The following check has been "promoted" from Linux to
# any system since it is pretty general
#
[ "$Tiger_Check_LISTENING" != 'N' ] && {
  progress_start "Checking for listening processes..."
  run_script check_listeningprocs >> $logtmp
  progress_end
}

# A general watchdog for system processes
[ "$Tiger_Check_RUNPROC" != 'N' ] && {
  progress_start "Checking for running processes..."
  run_script check_runprocs >> $logtmp
  progress_end
}

[ "$Tiger_Check_DELETED" != 'N' ] && {
  progress_start "Checking for processes using deleted files..."
  run_script check_finddeleted >> $logtmp
  progress_end
}

[ "$Tiger_Check_APACHE" != 'N' ] && {
  progress_start "Checking Apache's configuration..."
  run_script check_apache >> $logtmp
  progress_end
}

[ "$Tiger_Check_SSH" != 'N' ] && {
  progress_start "Checking SSHD's configuration..."
  run_script check_ssh >> $logtmp
  progress_end
}

[ "$Tiger_Check_SENDMAIL" != 'N' ] && {
  progress_start "Checking Sendmail's configuration..."
  run_script check_sendmail >> $logtmp
  progress_end
}

[ "$Tiger_Check_EXRC" != 'N' ] && {
  progress_start "Checking for exrc files..."
  run_script check_exrc >> $logtmp
  progress_end
}

# This test should be changed from Perl to shell script, also there
# is repeated functionality from check_listeningprocs (jfs)
#[ "$Tiger_Check_STRICTNW" != 'N' ] && {
#  echo "`$TIMECMD`> Checking for network configuration..."
#  run_script check_network >> $logtmp
#}

[ "$Tiger_Check_NTP" != 'N' ] && {
  progress_start "Checking NTP configuration..."
  run_script check_ntp >> $logtmp
  progress_end
}

#
# macOS-only checks: run_script finds nothing for them anywhere else,
# so they are gated on the OS as well as their toggle.
#
[ "$Tiger_Check_SIP" != 'N' ] && [ "$OS" = MacOSX ] && {
  progress_start "Checking System Integrity Protection..."
  run_script check_sip >> $logtmp
  progress_end
}

[ "$Tiger_Check_FILEVAULT" != 'N' ] && [ "$OS" = MacOSX ] && {
  progress_start "Checking FileVault..."
  run_script check_filevault >> $logtmp
  progress_end
}

[ "$Tiger_Check_DOAS" != 'N' ] && [ "$OS" = MacOSX ] && {
  progress_start "Checking the doas configuration..."
  run_script check_doas >> $logtmp
  progress_end
}

[ "$Tiger_Check_SOFTWARE" != 'N' ] && [ "$OS" = MacOSX ] && {
  progress_start "Checking installed software..."
  run_script check_software >> $logtmp
  progress_end
}

[ "$Tiger_Check_LAUNCHD" != 'N' ] && [ "$OS" = MacOSX ] && {
  progress_start "Checking boot daemons and agents..."
  run_script check_launchd >> $logtmp
  progress_end
}

#
# When not doing checks of all setuid executables, we can do
# embedded checks while the file system scans are running.
#
[ "$Tiger_Check_EMBEDDED" != 'N' -a "x$Tiger_Embed_Check_SUID" != 'xY' ] && {
  progress_start "Performing check of embedded pathnames..."
  run_script check_embedded >> $logtmp
  progress_end
}

[ "$Tiger_Check_FILESYSTEM" != 'N' -a "$Tiger_TESTMODE" != 'Y' ] && {
  progress_start "Waiting for filesystems scans to complete..."
  wait $fspid
  progress_end
  fspid=
  echo "`$TIMECMD`> Filesystems scans completed..."

  [ -s $WORKDIR/fsscan.log$$ ] && $CAT $WORKDIR/fsscan.log$$ >> $logtmp
  delete $WORKDIR/fsscan.log$$
}
#
# When checking SUID executables, wait until after file system scans
# have completed.
#
[ "$Tiger_Check_EMBEDDED" != 'N' -a "x$Tiger_Embed_Check_SUID" = 'xY' ] && {
  progress_start "Performing check of embedded pathnames..."
  run_script check_embedded >> $logtmp
  progress_end
}

[ -n "$crackpid" ] && {
  if /bin/kill -0 $crackpid 2>/dev/null; then
    if [ "$Tiger_Collect_CRACK" = 'Y' ]; then
      wait $crackpid
      $CAT $crackout >> $logtmp
      delete $crackout
    else
      echo "`$TIMECMD`> \`Crack' not finished. Output will be in $crackout."
      echo "# \`Crack' not finished. Output will be in $crackout." >> $logtmp
    fi
  else
    $CAT $crackout >> $logtmp
    delete $crackout
  fi
} 2>/dev/null

[ -n "$trippid" ] && {
    progress_start "Waiting for Tripwire to finish..."
    wait $trippid
    progress_end
    $CAT $tripout >> $logtmp
    delete $tripout
} 2>/dev/null

[ -n "$aidepid" ] && {
    progress_start "Waiting for Aide to finish..."
    wait $aidepid
    progress_end
    $CAT $aideout >> $logtmp
    delete $aideout
} 2>/dev/null

#echo "`$TIMECMD`> Security report completed for ${HOSTNAME}."

# Acceptances that have run out are findings again; say so once each
[ -n "$ACCEPT_FILE" ] && [ -f "$ACCEPT_FILE" ] && {
  today=`$DATE +%Y%m%d`
  while IFS="`printf '\t'`" read aid auntil aglob areason
  do
    case "$aid" in ''|\#*) continue ;; esac
    case "$auntil" in ''|-) continue ;; esac
    [ "`echo $auntil | $SED 's/-//g'`" -lt "$today" ] 2>/dev/null &&
      message WARN acpt001w "" "The acceptance of $aid expired on $auntil (reason given: $areason); it is reported again. Renew or remove it with tigris-accept." >> $logtmp
  done < "$ACCEPT_FILE"
}
naccepted=`$GREP -c . $Tiger_Accepted_Log 2>/dev/null`
[ "$naccepted" -gt 0 ] 2>/dev/null && {
  echo "" >> $logtmp
  echo "# $naccepted accepted findings were left out of this report (tigris-accept -l lists them; they are in the JSON report marked accepted)." >> $logtmp
}
delete $Tiger_Accepted_Log

# The exit status is the worst finding in the report, so cron and CI can
# act on it: 0 nothing at WARN or above, 2 a check could not run (ERROR),
# 3 WARN, 4 FAIL, 5 ALERT. 1 stays "the audit did not run". Accepted
# findings are not in the report, so they do not count.
tiger_status=0
for _lvl in ERROR:2 WARN:3 FAIL:4 ALERT:5
do
  $GREP -e "^--${_lvl%:*}-- " -e "<I>${_lvl%:*}</I>" $logtmp >/dev/null 2>&1 &&
    tiger_status=${_lvl#*:}
done
# A check skipped because it needs root (skip_check) could not run; one
# that does not apply to an offline root (--root) is not an error
skipped=`$GREP -c '^# Skipped ' $logtmp 2>/dev/null`
noroot=`$GREP -c '^# Skipped [^:]*: it needs root' $logtmp 2>/dev/null`
[ "${noroot:-0}" -gt 0 ] && [ $tiger_status -lt 2 ] && tiger_status=2

[ "$Tiger_TESTMODE" != 'Y' ] && {
  # The run in a few lines, counted from the JSON: per-level counts,
  # distinct ids, per-category counts, and the score with its formula.
  # Without a JSON report (Tiger_Output_JSON=N) there is nothing to
  # count from, so the report ends as it always has.
  [ -n "$Tiger_JSON_File" ] && sh $BASEDIR/util/summary "$Tiger_JSON_File" >>$logtmp
  echo "`$TIMECMD`> Security report completed for ${HOSTNAME}."
  echo "`$TIMECMD`> Security report completed for ${HOSTNAME}." >>$logtmp
  [ -n "$Tiger_JSON_File" ] && {
    counts=
    for level in ALERT FAIL WARN INFO ERROR
    do
      n=`$GREP -c "\"type\":\"finding\",\"level\":\"$level\"" $Tiger_JSON_File`
      counts="$counts${counts:+,}\"$level\":$n"
    done
    # distinct ids, per-category counts and the score, after the counts
    summary_extra=`sh $BASEDIR/util/summary -j "$Tiger_JSON_File" 2>/dev/null`
    echo "{\"type\":\"summary\",\"id\":\"$Tiger_Run_Id\",\"end\":\"`$DATE -u +%Y-%m-%dT%H:%M:%SZ`\",\"counts\":{$counts}$summary_extra,\"skipped\":${skipped:-0}}" >> $Tiger_JSON_File
    echo "Findings as JSON Lines are in \`$Tiger_JSON_File'."
  }

  if [ -n "`echo $LOGDIR | $AWK -F\@ '{print $2}'`" ]; then
    sendtologger $logtmp
  fi

  if [ "$EXPLAINREPORT" = "Y" ]; then
    $BASEDIR/tigexp -f $logtmp > $expreport
    $MV $logtmp $logfile
  elif [ "$EXPLAINREPORT" = "I" ]; then
    $BASEDIR/tigexp -F $logtmp > $logfile
    delete $logtmp
  else
    $MV $logtmp $logfile
  fi


  [ "$HTML" = "Y" ] && {
    htmlfile="$logfile.html"
    $MV $logfile $htmlfile
#    $CAT html/* >> $htmlfile
    echo "Security report is in \`$htmlfile'."
  }
  [ "$HTML" = "N" ] && {
    echo "Security report is in \`$logfile'."
  }
  [ "${noroot:-0}" -gt 0 ] && echo "$noroot checks need root and were skipped; run Tigris as root to include them."
  [ -n "$TIGRIS_ROOT" ] && [ "$skipped" -gt "${noroot:-0}" ] && echo "`expr $skipped - ${noroot:-0}` checks cannot read an offline root and were skipped; the report lists them."

  # --since: what changed since that run. The exit status then counts the
  # new findings only; with -q, nothing is printed unless something
  # changed, so cron mails only then.
  [ -n "$SINCE_RUN" ] && [ -n "$Tiger_JSON_File" ] && {
    [ "$QUIET" = 'Y' ] && exec 1>&3 3>&-
    if [ -z "$since_file" ]; then
      echo "No earlier run of $HOSTNAME in $LOGDIR to compare with: every finding of this run is new. The report is in \`$logfile'."
    else
      # one line: the status from the new findings that are not accepted,
      # then how many are new and how many were resolved
      set -- `$BASEDIR/tigris-diff -j "$since_file" "$Tiger_JSON_File" | $AWK '
      {
        s = $0
        i = index(s, "\"new\":["); j = index(s, "],\"resolved\":[")
        k = index(s, "],\"unchanged\":")
        new = substr(s, i + 7, j - i - 7); res = substr(s, j + 14, k - j - 14)
        # [{]: busybox awk takes a leading { in a pattern for a repetition
        n = (new == "" ? 0 : split(new, r, "[{]\"type\":\"finding\",") - 1)
        w = 0
        for (m = 2; m <= n + 1; m++) {
          if (index(r[m], "\"accepted\":{")) continue
          l = 0
          if (r[m] ~ /^"level":"ALERT"/) l = 5
          else if (r[m] ~ /^"level":"FAIL"/) l = 4
          else if (r[m] ~ /^"level":"WARN"/) l = 3
          else if (r[m] ~ /^"level":"ERROR"/) l = 2
          if (l > w) w = l
        }
        print w, n, (res == "" ? 0 : split(res, x, "[{]\"type\":\"finding\",") - 1)
      }'`
      tiger_status=${1:-0}
      # a run with skipped checks is still one where checks could not run
      [ "${noroot:-0}" -gt 0 ] && [ "$tiger_status" -lt 2 ] && tiger_status=2
      [ "$QUIET" != 'Y' ] || [ "${2:-0}" -gt 0 ] || [ "${3:-0}" -gt 0 ] &&
        $BASEDIR/tigris-diff "$since_file" "$Tiger_JSON_File"
    fi
  }
}

# Cleanup now before exiting
tigercleanup

#
exit $tiger_status
