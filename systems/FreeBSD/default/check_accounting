#
# check_accounting: is process accounting on. rc.conf enables it
#             (accounting_enable) and names the file; without it,
#             who ran what is nobody's record (act001w). Both the
#             switch and the file are read from the root, so this
#             works offline.
#
# 10/09/2026 - Initial version.
#
# References:
#   accton(8), rc.conf(5)
#
# Tigris: offline
#   the root's rc.conf and accounting file.
#
#-----------------------------------------------------------------------------
#
TigerInstallDir='.'

#
# Set default base directory.
# Order or preference:
#      -B option
#      TIGERHOMEDIR environment variable
#      TigerInstallDir installed location
#
basedir=${TIGERHOMEDIR:=$TigerInstallDir}

for parm
do
   case $parm in
   -B) basedir=$2; break;;
   esac
done

#
# Verify that a config file exists there, and if it does
# source it.
#
[ ! -r $basedir/config ] && {
  echo "--ERROR-- [init002e] No 'config' file in \`$basedir'."
  exit 1
}

. $basedir/config

. $BASEDIR/initdefs
#
# If run in test mode (-t) this will verify that all required
# elements are set.
#
[ "$Tiger_TESTMODE" = 'Y' ] && {
  haveallcmds AWK || exit 1
  haveallfiles BASEDIR WORKDIR || exit 1

  echo "--CONFIG-- [init003c] $0: Configuration ok..."
  exit 0
}

#------------------------------------------------------------------------

haveallcmds AWK || exit 1

echo
echo "# Checking process accounting..."

rc=`rootfile /etc/rc.conf`
enabled=
if [ -f "$rc" ]; then
  enabled=`$AWK -F= '/^accounting_enable=/ { v = $2; gsub(/[" \t]/, "", v); print tolower(v); exit }' "$rc" 2>/dev/null`
fi
if [ "$enabled" != yes ] && [ "$enabled" != true ] && [ "$enabled" != on ]; then
  message WARN act001w "Turn process accounting on (accounting_enable=\"YES\" in rc.conf, '/etc/rc.d/accounting start')." "Process accounting is not enabled: who ran what is nobody's record."
  exit 0
fi

acct=`rootfile /var/account/acct`
[ -f "$acct" ] || message WARN act001w "Turn process accounting on (accounting_enable=\"YES\" in rc.conf, '/etc/rc.d/accounting start')." "Process accounting is enabled but its file is missing: who ran what is nobody's record."

exit 0
