#
# check_pkg: are installed packages past their notices. `pkg
#             updating' lists the UPDATING entries that touch what
#             is installed, locally, without phoning home; any is
#             worth reading (upd006w). It cannot say which entries
#             are security, so it warns instead of failing. `pkg
#             audit' is deliberately not used: its database comes
#             over the network. portaudit is dead upstream, and
#             portmaster serves ports-tree shops only. pkg reads
#             the live database, so an offline root has nothing to
#             read and the check stays silent there.
#
# 10/09/2026 - Initial version. Tiger_Pkg_Cmd points at another
#             pkg, for the tests.
#
# References:
#   pkg-updating(8), pkg(8)
#
# Tigris: live system
#   Under --root it is skipped: the package database is the
#   running machine's, never a root's.
#
#-----------------------------------------------------------------------------
#
TigerInstallDir='.'

#
# Set default base directory.
# Order or preference:
#      -B option
#      TIGERHOMEDIR environment variable
#      TigerInstallDir installed location
#
basedir=${TIGERHOMEDIR:=$TigerInstallDir}

for parm
do
   case $parm in
   -B) basedir=$2; break;;
   esac
done

#
# Verify that a config file exists there, and if it does
# source it.
#
[ ! -r $basedir/config ] && {
  echo "--ERROR-- [init002e] No 'config' file in \`$basedir'."
  exit 1
}

. $basedir/config

. $BASEDIR/initdefs
#
# If run in test mode (-t) this will verify that all required
# elements are set.
#
[ "$Tiger_TESTMODE" = 'Y' ] && {
  haveallcmds AWK || exit 1
  haveallfiles BASEDIR WORKDIR || exit 1

  echo "--CONFIG-- [init003c] $0: Configuration ok..."
  exit 0
}

#------------------------------------------------------------------------

haveallcmds AWK || exit 1

# Under --root there is nothing to read: the database is live state
[ -n "$TIGRIS_ROOT" ] && exit 0

echo
echo "# Checking packages..."

pkg=${Tiger_Pkg_Cmd:-pkg}
n=`$pkg updating 2>/dev/null | $AWK 'NF { n++ } END { print n + 0 }'`
if [ "$n" -gt 0 ]; then
  message WARN upd006w "Read 'pkg updating' and upgrade what it names ('pkg upgrade'): some entries are security, and it does not say which." "$n package update notices touch installed packages: until someone reads them, an update with a security entry in it waits."
fi

exit 0
