#
# check_logfiles: the Mac's logs still incriminate after the fact, so
#             they must still be standing. A log anyone can rewrite
#             proves nothing (logf005f); the audit trail anyone can
#             read tells any local account who did what (logf009w).
#             Absence is not reported: in the unified-logging era a
#             missing text log is a configuration, not an attack.
#
# 10/09/2026 - Initial version.
#
# References:
#   newsyslog.conf(5), audit(4)
#
# Tigris: offline
#   the root's logs.
#
#-----------------------------------------------------------------------------
#
TigerInstallDir='.'

#
# Set default base directory.
# Order or preference:
#      -B option
#      TIGERHOMEDIR environment variable
#      TigerInstallDir installed location
#
basedir=${TIGERHOMEDIR:=$TigerInstallDir}

for parm
do
   case $parm in
   -B) basedir=$2; break;;
   esac
done

#
# Verify that a config file exists there, and if it does
# source it.
#
[ ! -r $basedir/config ] && {
  echo "--ERROR-- [init002e] No 'config' file in \`$basedir'."
  exit 1
}

. $basedir/config

. $BASEDIR/initdefs
#
# If run in test mode (-t) this will verify that all required
# elements are set.
#
[ "$Tiger_TESTMODE" = 'Y' ] && {
  haveallcmds AWK LS || exit 1
  haveallfiles BASEDIR WORKDIR || exit 1

  echo "--CONFIG-- [init003c] $0: Configuration ok..."
  exit 0
}

#------------------------------------------------------------------------

haveallcmds AWK LS || exit 1

echo
echo "# Checking log files..."

for log in /var/log/system.log /var/log/install.log /var/log/appfirewall.log
do
  f=`rootfile $log`
  [ -f "$f" ] || continue
  set X `$LS -lL "$f" 2>/dev/null | $AWK '{ print $1 }'`
  case "$2" in
    ????????w?) message FAIL logf005f "" "Log file \`$log' is writable past its owner: whoever can rewrite it edits what happened." ;;
  esac
done

audit=`rootfile /var/audit`
[ -d "$audit" ] || exit 0
for f in "$audit"/*
do
  [ -f "$f" ] || continue
  set X `$LS -lL "$f" 2>/dev/null | $AWK '{ print $1, $4 }'`
  mode=$2
  case "$mode" in
    ????????w?) message FAIL logf005f "" "Audit trail \`$f' is writable past its owner: whoever can rewrite it edits what happened." ;;
  esac
  case "$mode" in
    ???????r??) message WARN logf009w "" "Audit trail \`$f' is readable by anyone: any local account can read who did what." ;;
  esac
done

exit 0
