#
# check_crontabs: what cron runs for whom, on this Mac: /etc/crontab,
#             the periodic scripts it calls, and the per-user tabs in
#             /var/at/tabs. A tab writable by everyone hands cron to
#             anyone (cron008f); writable by its group, to the group's
#             members (cron008w); owned past root, to whoever owns it
#             (cron009w); a command without a full pathname runs
#             wherever cron's PATH points (cron001w). The same ids the
#             portable check reports, for the same meanings. Orphan
#             tabs (no such account) and at allow/deny are not judged:
#             the first needs the directory, the second is vestigial.
#
# 10/09/2026 - Initial version.
#
# References:
#   crontab(1), crontab(5), periodic(8)
#
# Tigris: offline
#   the root's crontabs and periodic scripts.
#
#-----------------------------------------------------------------------------
#
TigerInstallDir='.'

#
# Set default base directory.
# Order or preference:
#      -B option
#      TIGERHOMEDIR environment variable
#      TigerInstallDir installed location
#
basedir=${TIGERHOMEDIR:=$TigerInstallDir}

for parm
do
   case $parm in
   -B) basedir=$2; break;;
   esac
done

#
# Verify that a config file exists there, and if it does
# source it.
#
[ ! -r $basedir/config ] && {
  echo "--ERROR-- [init002e] No 'config' file in \`$basedir'."
  exit 1
}

. $basedir/config

. $BASEDIR/initdefs
#
# If run in test mode (-t) this will verify that all required
# elements are set.
#
[ "$Tiger_TESTMODE" = 'Y' ] && {
  haveallcmds AWK LS || exit 1
  haveallfiles BASEDIR WORKDIR || exit 1

  echo "--CONFIG-- [init003c] $0: Configuration ok..."
  exit 0
}

#------------------------------------------------------------------------

haveallcmds AWK LS || exit 1

echo
echo "# Checking crontabs..."

# tab_file FILE WHOSE: the ownership and writability judgments.
# Root-owned tabs are cron's own; anyone else's owner, or writers
# past the owner, can change what runs.
tab_file()
{
  file=$1 whose=$2
  set X `$LS -ln "$file" 2>/dev/null | $AWK '{ print $1, $3, $4 }'`
  mode=$2 owner=$3 group=$4
  [ -n "$mode" ] || return 0
  if [ "$owner" != 0 ]; then
    message WARN cron009w "" "\`$file' is owned by uid $owner, not root: uid $owner can change what cron runs from it."
  fi
  case "$mode" in
    ????????w?) message FAIL cron008f "chmod o-w '$file'" "\`$file' is writable by everyone: anyone can have cron run commands as $whose." ;;
    ?????w????) message WARN cron008w "chmod g-w '$file'" "\`$file' is writable by group \`$group': its members can have cron run commands as $whose." ;;
  esac
}

# tab_entries FILE SKIP: commands without a full pathname. The first
# SKIP fields are the schedule (and the user, for the system
# crontab); assignments and comments are not commands.
tab_entries()
{
  $AWK -v skip="$2" '
  /^[ \t]*#/ { next }
  /^[ \t]*$/ { next }
  {
    line = $0
    sub(/^[ \t]+/, "", line)
    if (line ~ /^[A-Za-z_][A-Za-z0-9_]*=/) next
    n = split(line, w, /[ \t]+/)
    if (w[1] ~ /^@/) {
      if (n >= 2 && w[2] !~ /^\//) print w[2]
      next
    }
    if (n <= skip) next
    cmd = w[skip+1]
    if (cmd !~ /^\//) print cmd
  }' "$1" 2>/dev/null | sort -u | while read -r cmd
  do
    message WARN cron001w "" "cron entry in $1 does not use full pathname ($cmd)."
  done
}

crontab=`rootfile /etc/crontab`
if [ -f "$crontab" ]; then
  tab_file "$crontab" root
  tab_entries "$crontab" 6
fi

tabs=`rootfile /var/at/tabs`
[ -d "$tabs" ] || tabs=
[ -n "$tabs" ] || {
  tabs=`rootfile /usr/lib/cron/tabs`
  [ -d "$tabs" ] || tabs=
}
if [ -n "$tabs" ]; then
  for tab in "$tabs"/*
  do
    [ -f "$tab" ] || continue
    whose=${tab##*/}
    tab_file "$tab" "$whose"
    tab_entries "$tab" 5
  done
fi

periodic=`rootfile /etc/periodic`
if [ -d "$periodic" ]; then
  for job in "$periodic"/*/*
  do
    [ -f "$job" ] || continue
    tab_file "$job" root
  done
fi

exit 0
