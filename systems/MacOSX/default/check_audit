#
# check_audit: is there an audit trail: audit_control configures it,
#             flags choose what is recorded. No audit_control means no
#             trail is configured (aud001w); flags that record almost
#             nothing mean almost nothing is recorded (aud002w). The
#             same ids the Linux check reports, for the same meanings.
#             Whether auditd is running right now is the process
#             watchdog's business, not this file's.
#
# 10/09/2026 - Initial version.
#
# References:
#   audit_control(5), auditd(8)
#
# Tigris: offline
#   the root's audit_control.
#
#-----------------------------------------------------------------------------
#
TigerInstallDir='.'

#
# Set default base directory.
# Order or preference:
#      -B option
#      TIGERHOMEDIR environment variable
#      TigerInstallDir installed location
#
basedir=${TIGERHOMEDIR:=$TigerInstallDir}

for parm
do
   case $parm in
   -B) basedir=$2; break;;
   esac
done

#
# Verify that a config file exists there, and if it does
# source it.
#
[ ! -r $basedir/config ] && {
  echo "--ERROR-- [init002e] No 'config' file in \`$basedir'."
  exit 1
}

. $basedir/config

. $BASEDIR/initdefs
#
# If run in test mode (-t) this will verify that all required
# elements are set.
#
[ "$Tiger_TESTMODE" = 'Y' ] && {
  haveallcmds AWK || exit 1
  haveallfiles BASEDIR WORKDIR || exit 1

  echo "--CONFIG-- [init003c] $0: Configuration ok..."
  exit 0
}

#------------------------------------------------------------------------

haveallcmds AWK || exit 1

echo
echo "# Checking the audit trail..."

control=`rootfile /etc/security/audit_control`
[ -f "$control" ] || {
  message WARN aud001w "Configure auditing in /etc/security/audit_control (flags like lo,ad,fm record logins, admin actions and file writes) and start auditd." "There is no audit_control: logins, changes to accounts and watched files are not recorded in an audit trail."
  exit 0
}

flags=`$AWK -F: '/^flags:/ { gsub(/,+$/, "", $2); print $2; exit }' "$control" 2>/dev/null`
case "$flags" in
  ''|-*) message WARN aud002w "Put what matters in the flags of /etc/security/audit_control: lo records logins, ad admin actions, fm file writes." "audit_control selects almost nothing, so the trail records almost nothing." ;;
esac

exit 0
