TESTEXEC=-x     # findcmd tests with it, as in the Linux configs

UUID=`id -u`
USERNAME=`whoami`
# This will work in most shells
[ "$UUID" = "" ] && UUID=$UID
[ "$USERNAME" = "" ] && USERNAME=$USER
export UUID

[ "$USERNAME" != "root" ] && {
  echo " " 1>&2
  echo "This script should be run from a super-user account." 1>&2
  echo " " 1>&2
}

findcmd()
{
  CMD=$1

  SRCH=/bin:/usr/bin:/usr/sbin:/sbin:/usr/local/bin:/usr/local/sbin

  SAVEIFS=$IFS
  IFS=:
  set $SRCH
  IFS=$SAVEIFS
  for dir
  do
    test $TESTEXEC $dir/$CMD && {
      echo $dir/$CMD
      return
    }
  done
}

AWK=`findcmd awk`
CAT=`findcmd cat`
CUT=`findcmd cut`
FIND=`findcmd find`
GREP=`findcmd grep`
LS=`findcmd ls`
SED=`findcmd sed`
SORT=`findcmd sort`
TR=`findcmd tr`
# delete() in initdefs removes the checks' temp files through it
RM=`findcmd rm`

# The checks run as children of the configured shell: export what
# they need, as the Linux configs do, or they see nothing
export TESTEXEC
export AWK CAT CUT FIND GREP LS SED SORT TR RM
