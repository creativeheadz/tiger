#
# check_pkg: do installed files still match their manifests. `pkg
#             verify' checks them locally, without phoning home;
#             any discrepancy is worth reading (ips001w). `pkg
#             audit' is deliberately not used: its database comes
#             over the network. pkg reads the live image, so an
#             offline root has nothing to read and the check stays
#             silent there. Only the count is judged, never the
#             output's exact shape, which follows the IPS version.
#
# 10/09/2026 - Initial version. Tiger_Pkg_Cmd points at another
#             pkg, for the tests.
#
# References:
#   pkg(1)
#
# Tigris: live system
#   Under --root it is skipped: the image is the running
#   machine's, never a root's.
#
#-----------------------------------------------------------------------------
#
TigerInstallDir='.'

#
# Set default base directory.
# Order or preference:
#      -B option
#      TIGERHOMEDIR environment variable
#      TigerInstallDir installed location
#
basedir=${TIGERHOMEDIR:=$TigerInstallDir}

for parm
do
   case $parm in
   -B) basedir=$2; break;;
   esac
done

#
# Verify that a config file exists there, and if it does
# source it.
#
[ ! -r $basedir/config ] && {
  echo "--ERROR-- [init002e] No 'config' file in \`$basedir'."
  exit 1
}

. $basedir/config

. $BASEDIR/initdefs
#
# If run in test mode (-t) this will verify that all required
# elements are set.
#
[ "$Tiger_TESTMODE" = 'Y' ] && {
  haveallcmds AWK || exit 1
  haveallfiles BASEDIR WORKDIR || exit 1

  echo "--CONFIG-- [init003c] $0: Configuration ok..."
  exit 0
}

#------------------------------------------------------------------------

haveallcmds AWK || exit 1

# Under --root there is nothing to read: the image is live state
[ -n "$TIGRIS_ROOT" ] && exit 0

echo
echo "# Checking packages..."

pkg=${Tiger_Pkg_Cmd:-pkg}
n=`$pkg verify 2>/dev/null | $AWK 'NF { n++ } END { print n + 0 }'`
if [ "$n" -gt 0 ]; then
  message WARN ips001w "Read 'pkg verify' and reinstall or repair what it names ('pkg fix'): changed system files are how intrusions persist." "$n installed files no longer match their manifests: until someone reads them, a changed file waits."
fi

exit 0
