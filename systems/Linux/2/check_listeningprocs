# check_listeningprocs - 08/23/2001
#
# 10/07/2026 atrimbitas  IPv6 listeners are reported: lsof records of type
#                 IPv6 were dropped, so a daemon on [::] or on a dual-stack
#                 socket (Syncthing's 22000) was never seen, and netstat's
#                 :::22 was cut at the first colon. The sockets come from
#                 ss when there is one, then lsof, then netstat; the port
#                 is what follows the last colon, and a process on 0.0.0.0
#                 and on :: is one finding on every interface.
# 10/07/2026 atrimbitas  Sockets on ports in the kernel's ephemeral range
#                 (ip_local_port_range) are reported once per process,
#                 user, protocol and address, with the ports in the
#                 detail: browsers and Syncthing hold UDP sockets on
#                 ports that change every run, and with the port in the
#                 message each run's findings looked new to tigris-diff
#                 and --since. The lin002i WARN for a listener on every
#                 interface no longer comes with an INFO copy (&& || on
#                 message(), which can return non-zero). Tiger_LSOF_Cmd
#                 lets the tests feed lsof -F fixtures.
# 07/05/2006 jfs  Try not to botch when udp6 services are being read
#                 (Debian Bug #375165)
# 05/15/2005 jfs  Proper check for processes in loopback (Debian Bug #307695)
# 05/02/2004 jfs  Try to avoid eval problems if handling variables with
#                 special characters (such as space)
# 09/19/2003 - jfs - Allow empty okprocess and okprocessuser with the patch
#   provided by Nicolas François. Also added patch improving the 
#   use of NETSTAT and LSOF. Information gathered by both is piped to
#   the same block to generated the report.
#   Reordered changelog.
# 04/23/2003 - jfs - Changed TigerInstallDir to '.'
# 10/16/2002 - jfs - Changed the case statement into an eval in order
#   to properly work for more than two processes or users
#   (i.e. with "process1|process2")
# 04/02/2018 - jfs - Detect if address is in the range 127.0.0.0/8 to 
#    declared it as a loopback address (Savannah bug #24159)
#         
#
# TODO:
# - this script seems to have problems if a program opens an UDP socket
#   expecting a reply from a remote host. This might lead to sockets reported
#   as open spuriously (see Debian Bug#136991). Should this be fixed?
#   (the socket is in fact open and could be accessed remotely)
#
# Tigris: needs root
#   only root sees which process holds another user's socket.
#
#-----------------------------------------------------------------------------
TigerInstallDir='.'


#
# Set default base directory.
# Order or preference:
#      -B option
#      TIGERHOMEDIR environment variable
#      TigerInstallDir installed location
#
basedir=${TIGERHOMEDIR:=$TigerInstallDir}

for parm
do
   case $parm in
   -B) basedir=$2; break;;
   esac
done

#
# Verify that a config file exists there, and if it does
# source it.
#
[ ! -r $basedir/config ] && {
  echo "--ERROR-- [init002e] No 'config' file in \`$basedir'."
  exit 1
}

. $basedir/config

. $BASEDIR/initdefs

#
# If run in test mode (-t) this will verify that all required
# elements are set.
#
[ "$Tiger_TESTMODE" = 'Y' ] && {
  haveallcmds CUT GREP EGREP || exit 1
# ss, lsof or netstat, in that order of preference
  [ -n "$SS" ] || [ -n "$LSOF" ] || haveallcmds NETSTAT || exit 1
  haveallfiles BASEDIR WORKDIR || exit 1
  haveallvars TESTLINK HOSTNAME
  
  message CONFIG init003c "" "$0: Configuration ok..."
  exit 0
}

#------------------------------------------------------------------------
echo
echo "# Checking listening processes "

haveallcmds CAT AWK SED SORT || exit 1

okprocessusers=${Tiger_Listening_ValidUsers-"root"}
okprocess=${Tiger_Listening_ValidProcs-""}
export okprocess okprocessusers

# The sockets come from ss (iproute2, on every current distribution), else
# lsof, else netstat, else /proc itself. busybox's lsof and netstat do not
# take the options used here (Alpine without iproute2 has only those), so
# they count as missing. Tiger_SS_Cmd, Tiger_LSOF_Cmd and Tiger_Netstat_Cmd
# replace the call, so the tests can feed each one a fixture;
# Tiger_Listening_Source=proc reads /proc whatever is installed.
busybox_tool()
{
  case "`readlink -f "$1" 2>/dev/null`" in */busybox*) return 0 ;; esac
  return 1
}
ss_cmd=${Tiger_SS_Cmd:-}
lsof_cmd=${Tiger_LSOF_Cmd:-}
netstat_cmd=${Tiger_Netstat_Cmd:-}
procnet=
if [ "$Tiger_Listening_Source" = proc ]; then
	procnet=Y
elif [ -z "$ss_cmd$lsof_cmd$netstat_cmd" ]; then
	if [ -n "$SS" ]; then
		ss_cmd="$SS -Hlntupe"
	elif [ -n "$LSOF" ] && ! busybox_tool "$LSOF"; then
		lsof_cmd="$LSOF -b -w -FpPcnLt -nPi"
	elif [ -n "$NETSTAT" ] && ! busybox_tool "$NETSTAT"; then
		haveallcmds CUT || exit 1
		netstat_cmd="$NETSTAT -lpeut --numeric-hosts --numeric-ports"
	else
		procnet=Y
	fi
fi

# Who a process is: its effective uid from /proc, as lsof has it, or the
# socket's owner when /proc has no answer; named with getent (busybox's
# id -nu takes only names)
OWNER_AWK='
	function euid(pid, uid,   file, line, f) {
		file = proc "/" pid "/status"
		while ((getline line < file) > 0)
			if (line ~ /^Uid:/) { split(line, f); uid = f[3]; break }
		close(file)
		return uid
	}
	function owner(uid,   cmd, line, f) {
		if (uid in names) return names[uid]
		names[uid] = uid
		if (getent != "") {
			cmd = getent " passwd " uid " 2>/dev/null"
			if ((cmd | getline line) > 0 && split(line, f, ":") > 2) names[uid] = f[1]
			close(cmd)
		} else {
			while ((getline line < "/etc/passwd") > 0)
				if (split(line, f, ":") > 2 && f[3] == uid) { names[uid] = f[1]; break }
			close("/etc/passwd")
		}
		return names[uid]
	}
'
procdir="${Tiger_Sysctl_Root:-}/proc"

# The kernel's ephemeral port range. A socket in it was most likely given
# its port by the kernel (browsers, Syncthing and other clients keep UDP
# sockets open on such ports), so the port changes from run to run. Those
# are reported once per process, user, protocol and address, with the
# ports in the detail rather than the message, so that a finding means
# the same thing in two runs and --since does not call it new each time.
set -- `$CAT "${Tiger_Sysctl_Root:-}/proc/sys/net/ipv4/ip_local_port_range" 2>/dev/null`
eph_lo=$1 eph_hi=$2
case "$eph_lo$eph_hi" in ''|*[!0-9]*) eph_lo=32768 eph_hi=60999 ;; esac

[ -n "$netstat_cmd" ] && message INFO lin004i "" "Using netstat instead of ss or lsof, information regarding processes will be more limited"

# One line per listening socket and process: user, protocol, the local
# address as the tool prints it, and the process name (the rest of the line)
if [ -n "$ss_cmd" ]; then
	# The user is each process's effective uid, from /proc as lsof has
	# it: a daemon that binds as root and then switches user (dnsmasq,
	# the workers of nginx) is reported as that user. When /proc has no
	# answer, the socket's owner, which ss leaves out for root. A socket
	# with no users:((...)) is the kernel's or, when not run as root,
	# another user's, and is left out as lsof leaves it out.
	$ss_cmd 2>/dev/null |
	$AWK -v getent="$GETENT" -v proc="$procdir" "$OWNER_AWK"'
	{
		uid = 0
		for (i = 7; i <= NF; i++)
			if ($i ~ /^uid:[0-9]+$/) uid = substr($i, 5)
		p = index($0, "users:((")
		if (p == 0) next
		# users:(("sshd",pid=1239,fd=3),("systemd",pid=1,fd=200))
		procs = substr($0, p + 7)
		while (match(procs, /\("[^"]*",pid=[0-9]+/)) {
			m = substr(procs, RSTART + 2, RLENGTH - 2)
			q = index(m, "\",pid=")
			print owner(euid(substr(m, q + 6), uid)), toupper($1), $5, substr(m, 1, q - 1)
			procs = substr(procs, RSTART + RLENGTH)
		}
	}'
elif [ -n "$procnet" ]; then
	# The kernel's own tables: a listening TCP socket is state 0A, an
	# unconnected UDP one 07 with no remote address. Addresses are hex,
	# IPv4 in host (little-endian) order, IPv6 as four such words. The
	# socket's inode leads to the processes holding it, through their
	# fd links (one ls for all of them).
	$LS -l "$procdir"/[0-9]*/fd/ 2>/dev/null |
	$AWK -v getent="$GETENT" -v proc="$procdir" "$OWNER_AWK"'
	function hex(h,   i, v) {
		v = 0
		for (i = 1; i <= length(h); i++) v = v * 16 + index("0123456789ABCDEF", toupper(substr(h, i, 1))) - 1
		return v
	}
	function v4(h) { return hex(substr(h, 7, 2)) "." hex(substr(h, 5, 2)) "." hex(substr(h, 3, 2)) "." hex(substr(h, 1, 2)) }
	function v6(h,   s, w, x, g, out) {
		s = ""
		for (w = 0; w < 4; w++) { x = substr(h, w * 8 + 1, 8); s = s substr(x, 7, 2) substr(x, 5, 2) substr(x, 3, 2) substr(x, 1, 2) }
		s = toupper(s)
		if (s == "00000000000000000000000000000000") return "::"
		if (s == "00000000000000000000000000000001") return "::1"
		if (substr(s, 1, 24) == "00000000000000000000FFFF") return "::ffff:" hex(substr(s, 25, 2)) "." hex(substr(s, 27, 2)) "." hex(substr(s, 29, 2)) "." hex(substr(s, 31, 2))
		out = ""
		for (g = 0; g < 8; g++) out = out (g ? ":" : "") sprintf("%x", hex(substr(s, g * 4 + 1, 4)))
		return out
	}
	# the fd listing: "/proc/PID/fd:" then its links
	/\/fd\/?:$/ { pid = $0; sub(/\/fd\/?:$/, "", pid); sub(/.*\//, "", pid); next }
	/ -> socket:\[/ { i = $NF; gsub(/[^0-9]/, "", i); pids[i] = pids[i] " " pid; next }
	END {
		split("tcp tcp6 udp udp6", files, " ")
		for (f = 1; f <= 4; f++) {
			file = proc "/net/" files[f]; proto = (files[f] ~ /^tcp/) ? "TCP" : "UDP"; six = (files[f] ~ /6$/)
			first = 1
			while ((getline line < file) > 0) {
				if (first) { first = 0; continue }
				n = split(line, c, " ")
				split(c[2], la, ":"); split(c[3], ra, ":")
				if (proto == "TCP" && c[4] != "0A") continue
				if (proto == "UDP" && (c[4] != "07" || ra[1] !~ /^0+$/)) continue
				addr = six ? "[" v6(la[1]) "]" : v4(la[1])
				port = hex(la[2]); inode = c[10]
				m = split(pids[inode], p, " ")
				for (k = 1; k <= m; k++) {
					comm = ""
					cf = proc "/" p[k] "/comm"
					if ((getline comm < cf) <= 0) comm = ""
					close(cf)
					if (comm != "") print owner(euid(p[k], c[8])), proto, addr ":" port, comm
				}
			}
			close(file)
		}
	}'
elif [ -n "$lsof_cmd" ]; then
	$AWK -v cmd="$lsof_cmd" '
	BEGIN {

		while ((cmd | getline field) > 0){
			fieldtype = substr(field,1,1)
			sub("^.","",field)
			if      ("p" == fieldtype) {
			}
			else if ("c" == fieldtype) {
				command = field
			}
			else if ("L" == fieldtype) {
				user = field
			}
			else if ("t" == fieldtype) {
				type = field
			}
			else if ("P" == fieldtype) {
				proto = field
			}
			else if ("n" == fieldtype) {
				addr = field
				if (( type == "IPv4" || type == "IPv6" ) && ( addr !~ "->" )) {
					printf ("%s %s %s %s\n", user, proto, addr, command)
				}
			}
		}
		close(cmd)
	}'
else
	$netstat_cmd |
	# remove header
	$SED -e '1d;2d' |
	while read type x y local remote listen user inode proc
	do
		case "$type" in
		udp|udp6)
			# there is no listen filed, every field are shifted left
			user=$listen
			proc="$inode $proc"
			type="UDP"
			;;
		tcp|tcp6)
			type="TCP"
			;;
		*)
			continue
			;;
		esac

		echo $user $type $local "`echo $proc | $CUT -f 2 -d /`"
	done
fi |
# The address in words: "every" for any address, "loopback", the
# interface a socket is bound to (ss prints "0.0.0.0%eth0"), or the address
# itself without brackets or zone. The port is what follows the last colon,
# so IPv6 needs no special case: [::1]:631 (lsof, ss) and ::1:631 (netstat).
$AWK '
{
	rest = $0; sub(/^[^ ]* [^ ]* [^ ]* */, "", rest)
	n = split($3, a, ":"); port = a[n]
	if (port !~ /^[0-9]+$/) next
	addr = substr($3, 1, length($3) - length(port) - 1)
	sub(/^\[/, "", addr); sub(/\]$/, "", addr)
	dev = ""
	p = index(addr, "%")
	if (p) { dev = substr(addr, p + 1); addr = substr(addr, 1, p - 1) }
	if (addr ~ /^::ffff:[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) addr = substr(addr, 8)
	if (addr == "" || addr == "*" || addr == "0.0.0.0" || addr == "::")
		addr = (dev != "" ? dev : "every")
	else if (addr ~ /^127\./ || addr == "::1")
		addr = "loopback"
	print $1, $2, addr, port, rest
}' |
# remove duplicates (a process on 0.0.0.0 and on :: is on every interface
# once), fold the ephemeral ports of one process, user, protocol and
# address into one line (the ports in the fifth field, "-" when there are
# none), and sort on process
$SORT -u |
$AWK -v lo="$eph_lo" -v hi="$eph_hi" '
{
	# the process name is the rest of the line: it may hold spaces
	rest = $0; sub(/^[^ ]* [^ ]* [^ ]* [^ ]* */, "", rest)
	port = $4
	if (port + 0 >= lo + 0 && port + 0 <= hi + 0) {
		head = $1 " " $2 " " $3 " ephemeral"
		g = head " " rest
		if (!(g in ports)) { order[++ng] = g; heads[g] = head; names[g] = rest }
		ports[g] = ports[g] (ports[g] == "" ? "" : ",") port
	} else
		print $1, $2, $3, port, "-", rest
}
END { for (i = 1; i <= ng; i++) print heads[order[i]], ports[order[i]], names[order[i]] }' |
$SORT -k 6 |
while read user type address socket ports proc
do
	if [ "$socket" = "ephemeral" ]; then
		socktext="ephemeral ports"
		case "$ports" in *,*) trail="Ports" ;; *) trail="Port" ;; esac
		trail="$trail `echo $ports | $SED 's/,/, /g'`; the kernel gives out $eph_lo-$eph_hi, so they change from run to run."
	else
		socktext="socket $socket"
		trail=""
	fi
	isokprocess="no"
	isokuser="no"
	# TODO This should change into a function since it's used twice in the
	# code
	[ -n "$okprocess" ] && \
	isokprocess=`eval "case \"$proc\" in ${okprocess})  echo \"yes\" ;; \
	*) echo \"no\" ;; esac"`
	# Probably redundant since this is done already at the top
	[ -n "$okprocessusers" ] && \
	isokuser=`eval "case \"$user\" in ${okprocessusers})  echo \"yes\" ;; \
	*) echo \"no\" ;; esac"`
	if [ "$isokprocess" = "no" ] ; then
		if [ "$isokuser" = "yes" ] ; then
			# an if, not && ||: message() can return non-zero, and
			# the INFO line would then follow every WARN
			if [ "$address" = "every" -a "$Tiger_Listening_Every" != "N" ]; then
				message WARN lin002i "$trail" "The process \`$proc' is listening on $socktext ($type) on $address interface."
			else
				message INFO lin002i "$trail" "The process \`$proc' is listening on $socktext ($type) on $address interface."
			fi
		else
			[ "$address" != "loopback" ]  && {
				message WARN lin003w "$trail" "The process \`$proc' is listening on $socktext ($type on $address interface) is run by $user."
			} 
		fi # of if okuser
	fi # of if okprocess

done 

exit 0 
