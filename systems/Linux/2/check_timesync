#
# check_timesync: is the clock kept synchronised, by one daemon.
#
# 10/07/2026 atrimbitas - Initial version, beside check_ntp, which only
#                 looks at the configuration of an ntpd serving time. The
#                 daemons are found among /proc/PID/comm (names cut to 15
#                 characters: systemd-timesyncd is systemd-timesyn).
#                 Whether the clock is synchronised comes from chronyc
#                 tracking when chronyd runs (it marks the kernel clock
#                 synchronised only with rtcsync, so timedatectl could say
#                 no), and from timedatectl show otherwise. A container
#                 runs on its host's clock and is left alone.
#                 Tiger_Sysctl_Root prefixes /proc and the container
#                 markers; Tiger_Timedatectl_Cmd and Tiger_Chronyc_Cmd
#                 replace the two commands, for the tests.
#
# References:
#   man 1 timedatectl, man 1 chronyc, man 8 systemd-timesyncd
#
# Tigris: live system
#   Under --root it is skipped: it reads the running time daemon and the kernel clock.
#
#-----------------------------------------------------------------------------
#
TigerInstallDir='.'

#
# Set default base directory.
# Order or preference:
#      -B option
#      TIGERHOMEDIR environment variable
#      TigerInstallDir installed location
#
basedir=${TIGERHOMEDIR:=$TigerInstallDir}

for parm
do
   case $parm in
   -B) basedir=$2; break;;
   esac
done

#
# Verify that a config file exists there, and if it does
# source it.
#
[ ! -r $basedir/config ] && {
  echo "--ERROR-- [init002e] No 'config' file in \`$basedir'."
  exit 1
}

. $basedir/config

. $BASEDIR/initdefs

#
# If run in test mode (-t) this will verify that all required
# elements are set.
#
[ "$Tiger_TESTMODE" = 'Y' ] && {
  haveallcmds AWK CAT SED SORT || exit 1
  haveallfiles BASEDIR WORKDIR || exit 1

  echo "--CONFIG-- [init003c] $0: Configuration ok..."
  exit 0
}

#------------------------------------------------------------------------

haveallcmds AWK CAT SED SORT || exit 1

root=${Tiger_Sysctl_Root:-}

# A container keeps its host's time
[ -f "$root/.dockerenv" ] || [ -f "$root/run/.containerenv" ] || [ -f "$root/run/systemd/container" ] && exit 0

echo
echo "# Checking time synchronisation..."

findtool()
{
  for d in /usr/bin /bin /usr/sbin /sbin
  do
    [ -x "$d/$1" ] && { echo "$d/$1"; return 0; }
  done
  return 1
}

# The time daemons running, by the name people know them by
daemons=`$CAT "$root"/proc/[0-9]*/comm 2>/dev/null | $AWK '
  $0 == "chronyd" || $0 == "ntpd" || $0 == "openntpd" || $0 == "ptp4l" { d[$0] = 1 }
  $0 == "systemd-timesyn" { d["systemd-timesyncd"] = 1 }
  END { for (n in d) print n }' | $SORT | $AWK '{ printf "%s%s", (NR > 1 ? " " : ""), $0 }'`

case "$daemons" in
  '')
    message WARN time001w "Install and enable one: systemd-timesyncd ('timedatectl set-ntp true') or chrony." "No time synchronisation daemon is running (chronyd, systemd-timesyncd, ntpd): the clock drifts, and logs, certificates and Kerberos tickets go wrong with it."
    exit 0
    ;;
  *' '*)
    message WARN time004w "Running: $daemons. Keep one: disable the others ('systemctl disable --now NAME')." "More than one time synchronisation daemon is running, and they correct the clock against each other."
    ;;
esac

# Synchronised? chronyc for chronyd, timedatectl for the rest
synced= source=
case " $daemons " in
  *" chronyd "*)
    cmd=${Tiger_Chronyc_Cmd:-}
    [ -z "$cmd" ] && c=`findtool chronyc` && cmd="$c -n tracking"
    if [ -n "$cmd" ]; then
      out=`$cmd 2>/dev/null`
      case "$out" in
        *"Leap status"*"Not synchronised"*) synced=no ;;
        *"Leap status"*) synced=yes
          source=`echo "$out" | $SED -n 's/^Reference ID *: [0-9A-Fa-f]* (\(.*\))$/\1/p'` ;;
      esac
    fi
    by=chronyd
    ;;
  *)
    cmd=${Tiger_Timedatectl_Cmd:-}
    [ -z "$cmd" ] && c=`findtool timedatectl` && cmd="$c show"
    if [ -n "$cmd" ]; then
      case "`$cmd 2>/dev/null | $SED -n 's/^NTPSynchronized=//p'`" in
        yes) synced=yes ;;
        no) synced=no ;;
      esac
    fi
    by=`echo "$daemons" | $SED 's/ .*//'`
    ;;
esac

case "$synced" in
  yes) message INFO time003i "" "The clock is synchronised by $by${source:+ (from $source)}." ;;
  no)  message WARN time002w "See 'chronyc sources' or 'timedatectl timesync-status': the servers may be unreachable (a firewall blocking UDP port 123 outbound), or none is configured." "$by is running, but the clock is not synchronised." ;;
esac

exit 0
