# check_release: verifies that system meets minimum release requirements
# 10.26.2001
# Paul Telford <paul_telford@hp.com>
# 07/25/2002 jfs       Changed TigerInstallDir to .
# 10/01/2003 jfs       Fixed message calls
# 11/09/2003 jfs       Removed typeset bashism and updated RedHat versions so
#            only 7.1 or greater are consider current (Debian Bug 219764)
# 01/15/2004 jfs       Updated RedHat version (now it's 9 or greater), but
#            added a note regarding Progeny support...
# 03/21/2005 jfs       Use EGREP instead of grep -E
# 04/25/2007 jfs       Update Debian version, current is 5.0
# 02/06/2018 jfs       Update Debian version, current stable is 9.3
#                      and list of old Debian versions
#                      Add support to check for RHEL and Ubuntu releases
#                      Ubuntu is no longer considered a Debian "unstable" version
#                      (Ubuntu bug 248845)
# 10/10/2026 atrimbitas os-release, live and offline, and the end of each
#                      release's security support from eol_list instead of
#                      thresholds from 2018: RHEL 9 was "Unreleased Red Hat
#                      Linux version `release'", Fedora a shell error, and
#                      Debian 9 passed as current.
#
#-----------------------------------------------------------------------------
# TODO:
# - Support more distributions (SuSE, Mandrake...)
#
#-----------------------------------------------------------------------------
#
# Tigris: offline
#   the root's os-release (or its older release files), judged against
#   the end-of-support table eol_list (util/mkeol, from endoflife.date),
#   the same way live and offline.
#   The guest leg at the end is the exception: cpuinfo, DMI and
#   /sys/hypervisor describe the auditing host, never a root, so
#   under --root it is skipped (a live-system section).
#
TigerInstallDir='.'

#
# Set default base directory.
# Order or preference:
#      -B option
#      TIGERHOMEDIR environment variable
#      TigerInstallDir installed location
#
basedir=${TIGERHOMEDIR:=$TigerInstallDir}

for parm
do
   case $parm in
   -B) basedir=$2; break;;
   esac
done
#
# Verify that a config file exists there, and if it does
# source it.
#
[ ! -r $basedir/config ] && {
  echo "--ERROR-- [init002e] No 'config' file in \`$basedir'."
  exit 1
}
. $basedir/config

. $BASEDIR/initdefs
#
# If run in test mode (-t) this will verify that all required
# elements are set.
#
[ "$Tiger_TESTMODE" = 'Y' ] && {
  haveallcmds CAT AWK SED TR DATE || exit 1
  haveallfiles BASEDIR WORKDIR || exit 1

  echo "--CONFIG-- [init003c] $0: Configuration ok..."
  exit 0
}
#------------------------------------------------------------------------

echo
echo "# Checking OS release..."
haveallcmds CAT AWK SED TR DATE || exit 1
haveallfiles BASEDIR WORKDIR || exit 1

# The release, from os-release: the root's under --root, this host's
# otherwise. (lsb_release, a Python program many systems lack, is not
# asked; it reads the same file.) Without one, the older release files.
osrel=`__here /etc/os-release`
[ -r "$osrel" ] || osrel=`__here /usr/lib/os-release`
# osval KEY: the value of KEY in os-release, quotes taken off
osval()
{
  [ -r "$osrel" ] || return 0
  $AWK -F= -v k="$1" -v q="'" '$1 == k { v = substr($0, length(k) + 2); gsub(/"/, "", v); gsub(q, "", v); print v; exit }' "$osrel"
}
rel_id=`osval ID`; rel_ver=`osval VERSION_ID`; rel_name=`osval NAME`
deb=`__here /etc/debian_version`; rh=`__here /etc/redhat-release`
if [ -z "$rel_id" ]; then
  if [ -r "$rh" ]; then
    rhtext=`$CAT "$rh"`
    case "$rhtext" in
      "Red Hat Linux release"*)
        # Red Hat Linux, before Red Hat Enterprise Linux: its last
        # release, 9, lost its updates in 2004
        message FAIL osv001f "" "This is $rhtext, which has had no security updates since 2004: Red Hat Linux ended with release 9."
        exit 0 ;;
      CentOS*) rel_id=centos ;;
      *) rel_id=rhel ;;
    esac
    rel_name=`printf '%s\n' "$rhtext" | $SED 's/ release.*//'`
    rel_ver=`printf '%s\n' "$rhtext" | $SED -n 's/.* release \([0-9][0-9.]*\).*/\1/p'`
  elif [ -r "$deb" ]; then
    rel_id=debian; rel_name="Debian GNU/Linux"
    rel_ver=`$SED -n '1s/^\([0-9][0-9]*\).*/\1/p' "$deb"`
  fi
fi

# Debian testing or unstable: no VERSION_ID, a codename in
# debian_version. The security team supports neither.
if [ "$rel_id" = debian ] && [ -z "$rel_ver" ]; then
  codename=`$CAT "$deb" 2>/dev/null`
  message WARN osv004w "" "This is Debian testing or unstable (${codename:-no release number}), which the Debian security team does not support."
  rel_id=
fi

# The end of the release's security support, from the table util/mkeol
# makes from endoflife.date: the release as named there is VERSION_ID
# itself, or its first two parts (Alpine's 3.24.2 is 3.24), or its
# first (Rocky's 9.3 is 9). CentOS Stream's os-release says centos; LMDE's
# says linuxmint.
eol=; ext=
if [ -n "$rel_id" ] && [ -n "$rel_ver" ] && [ -r "$EOL_LIST" ]; then
  key=$rel_id; pre=
  case "$rel_id:$rel_name" in
    centos:*Stream*) key=centos-stream ;;
    linuxmint:LMDE*) pre=lmde ;;
  esac
  set -- `$AWK -v id="$key" -v v="$rel_ver" -v pre="$pre" '
    BEGIN { n = split(v, p, "."); c[1] = pre v; c[2] = pre p[1] "." p[2]; c[3] = pre p[1] }
    /^#/ { next }
    $1 == id { for (i = 1; i <= 3; i++) if ($2 == c[i] && !(i in hit)) hit[i] = $3 " " $4 }
    END { for (i = 1; i <= 3; i++) if (i in hit) { print hit[i]; exit } }' "$EOL_LIST"`
  eol=$1; ext=$2
fi
# Tiger_Today (YYYYMMDD) stands in for the date, for the tests
today=${Tiger_Today:-`$DATE +%Y%m%d`}
ended=
case "$eol" in
  past) ended=Y ;;
  [0-9]*-*-*) [ "`echo $eol | $TR -d -`" -lt "$today" ] 2>/dev/null && ended=Y ;;
esac
if [ -n "$ended" ]; then
  detail="Upgrade to a release the distribution still supports."
  case "$ext" in
    [0-9]*-*-*) [ "`echo $ext | $TR -d -`" -ge "$today" ] 2>/dev/null &&
      detail="Paid extended support for it runs until $ext; without it, upgrade to a release the distribution still supports." ;;
  esac
  case "$eol" in
    past) message FAIL osv002f "$detail" "$rel_name $rel_ver is past the end of its security support." ;;
    *) message FAIL osv002f "$detail" "$rel_name $rel_ver has had no security updates since $eol." ;;
  esac
fi


# virt_guest SYSROOT: the hypervisor's name when the host whose /proc
# and /sys live under SYSROOT (empty: this host) is a virtual guest,
# "unknown" when it is a guest on no recognized platform, and nothing
# when it is bare metal. Xen's /sys/hypervisor/type is authoritative;
# then the DMI names, lowercased; then the hypervisor bit in cpuinfo.
virt_guest()
{
  __type=`$CAT "$1/sys/hypervisor/type" 2>/dev/null`
  case "$__type" in
    xen) echo xen; return;;
  esac
  __dmi=`{ $CAT "$1/sys/devices/virtual/dmi/id/sys_vendor" 2>/dev/null; $CAT "$1/sys/devices/virtual/dmi/id/product_name" 2>/dev/null; } | $TR 'A-Z' 'a-z'`
  case "$__dmi" in
    *vmware*) echo vmware; return;;
    *virtualbox*|*innotek*) echo virtualbox; return;;
    *parallels*) echo parallels; return;;
    *qemu*|*kvm*|*bochs*|*seabios*) echo kvm; return;;
    *bhyve*|*bh-yve*|*bh_yve*) echo bhyve; return;;
    *hyper-v*|*hyperv*|*microsoft*virtual*) echo hyper-v; return;;
    *xen*|*hvm*domu*) echo xen; return;;
    *amazon*|*ec2*) echo ec2; return;;
    *google*compute*|*google*cloud*) echo gce; return;;
    *openstack*|*nova*) echo openstack; return;;
  esac
  case "`$CAT "$1/proc/cpuinfo" 2>/dev/null`" in
    *hypervisor*) echo unknown;;
  esac
}

# Tigris: live system
#   cpuinfo, DMI and /sys/hypervisor describe the auditing host, never
#   a root under audit, so under --root there is nothing to say.
if [ -z "$TIGRIS_ROOT" ]; then
  guest=`virt_guest "${Tiger_Sysctl_Root:-}"`
  [ -n "$guest" ] && message INFO osv003i "" "This machine is a virtual guest ($guest): the findings below describe the guest, while host-level facts, like disk encryption or Secure Boot, describe the machine it runs on instead."
fi
