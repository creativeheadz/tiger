#
# check_mac: is a mandatory access control system (AppArmor, SELinux
#                 or TOMOYO) confining anything, and is PaX switched on.
#
# 10/07/2026 atrimbitas - Initial version. The active security modules are
#                 /sys/kernel/security/lsm; AppArmor's loaded profiles and
#                 their modes are in its securityfs (readable by root
#                 only), SELinux's mode in /sys/fs/selinux/enforce. Profiles
#                 in complain mode are listed in the summary rather than
#                 reported one by one: Ubuntu ships several that way.
#                 Tiger_Sysctl_Root prefixes /sys for the tests.
# 10/09/2026 - TOMOYO (domains in enforcing mode, from its securityfs
#                 profile) and PaX (softmode off means on). TOMOYO's
#                 verdict stands on its own: where it reports, the
#                 "neither AppArmor nor SELinux" warning stays quiet.
#
# References:
#   https://gitlab.com/apparmor/apparmor/-/wikis/Documentation
#   man 8 selinux
#   https://tomoyo.osdn.jp/documentation/
#   https://pax.grsecurity.net/docs/
#
# Tigris: needs root
#   AppArmor's list of profiles is root's to read, and so is TOMOYO's.
#
# Tigris: live system
#   Under --root it is skipped: it reads the profiles loaded in the running kernel.
#
#-----------------------------------------------------------------------------
#
TigerInstallDir='.'

#
# Set default base directory.
# Order or preference:
#      -B option
#      TIGERHOMEDIR environment variable
#      TigerInstallDir installed location
#
basedir=${TIGERHOMEDIR:=$TigerInstallDir}

for parm
do
   case $parm in
   -B) basedir=$2; break;;
   esac
done

#
# Verify that a config file exists there, and if it does
# source it.
#
[ ! -r $basedir/config ] && {
  echo "--ERROR-- [init002e] No 'config' file in \`$basedir'."
  exit 1
}

. $basedir/config

. $BASEDIR/initdefs

#
# If run in test mode (-t) this will verify that all required
# elements are set.
#
[ "$Tiger_TESTMODE" = 'Y' ] && {
  haveallcmds AWK CAT GREP SED || exit 1
  haveallfiles BASEDIR WORKDIR || exit 1

  echo "--CONFIG-- [init003c] $0: Configuration ok..."
  exit 0
}

#------------------------------------------------------------------------

haveallcmds AWK CAT GREP SED || exit 1

sys="${Tiger_Sysctl_Root:-}/sys"
proc="${Tiger_Sysctl_Root:-}/proc"
# Nothing to judge without the kernel's view (a container without /sys)
[ -d "$sys/kernel" ] || exit 0

echo
echo "# Checking mandatory access control (AppArmor, SELinux, TOMOYO, PaX)..."

# The active security modules; older kernels have no list, and then the
# modules' own files say whether they are on
lsm=`$CAT "$sys/kernel/security/lsm" 2>/dev/null`
if [ -z "$lsm" ]; then
  [ "`$CAT "$sys/module/apparmor/parameters/enabled" 2>/dev/null`" = Y ] && lsm="$lsm,apparmor"
  [ -r "$sys/fs/selinux/enforce" ] && lsm="$lsm,selinux"
fi
case ",$lsm," in
  *,tomoyo,*) ;;
  *) [ -d "$sys/kernel/security/tomoyo" ] && lsm="$lsm,tomoyo" ;;
esac

# TOMOYO reports on its own, before the AppArmor/SELinux verdict: its
# domains enforcing, or active and enforcing nothing
sawtomoyo=
case ",$lsm," in
  *,tomoyo,*)
    sawtomoyo=1
    profile="$sys/kernel/security/tomoyo/profile"
    if ! $CAT "$profile" > /dev/null 2>&1; then
      message ERROR mac004e "" "TOMOYO is active, but its profile cannot be read from $profile: that needs root, and securityfs mounted on /sys/kernel/security."
    else
      enforcing=`$GREP -c 'mode=enforcing' "$profile" 2>/dev/null`
      if [ -n "$enforcing" ] && [ "$enforcing" -gt 0 ]; then
        d=domains; [ "$enforcing" -eq 1 ] && d=domain
        message INFO mac008i "" "TOMOYO is enforcing $enforcing $d."
      else
        message WARN mac007w "TOMOYO is loaded, but no domain is in enforcing mode (learning and permissive only log). Move the policy's domains to enforcing ('tomoyo-loadpolicy') once the learning is done." "TOMOYO confines nothing: a compromised service can reach everything its user can."
      fi
    fi
    ;;
esac

# PaX reports on its own too: softmode on means the hardening is
# compiled in and switched off by default
case "`$CAT "$proc/sys/kernel/pax/softmode" 2>/dev/null`" in
  1) message WARN mac005w "Turn PaX softmode off ('sysctl kernel.pax.softmode=0') unless chosen binaries carry their own PaX flags ('paxctl -v'): as it stands nothing is hardened by default." "PaX is in softmode: the exploit mitigation is compiled in and switched off." ;;
  0) message INFO mac006i "" "PaX is enforcing." ;;
esac

case ",$lsm," in
  *,selinux,*)
    case "`$CAT "$sys/fs/selinux/enforce" 2>/dev/null`" in
      1) message INFO mac003i "" "SELinux is enforcing." ;;
      0) message WARN mac002w "SELinux denies nothing in permissive mode; it only logs. Set SELINUX=enforcing in /etc/selinux/config (and 'setenforce 1' for now) once the logged denials ('ausearch -m avc') are dealt with." "SELinux is in permissive mode: it logs what its policy would deny, and denies nothing." ;;
      *) message WARN mac001w "SELinux is active but has no policy loaded." "No mandatory access control is enforcing: a compromised service can reach everything its user can." ;;
    esac
    ;;
  *,apparmor,*)
    profiles="$sys/kernel/security/apparmor/profiles"
    if ! $CAT "$profiles" > /dev/null 2>&1; then
      message ERROR mac004e "" "AppArmor is active, but its profiles cannot be read from $profiles: that needs root, and securityfs mounted on /sys/kernel/security."
    else
      # one line per profile, "name (mode)"
      set -- `$AWK '{ m = $NF; gsub(/[()]/, "", m); n[m]++ } END { print n["enforce"] + 0, n["complain"] + 0, n["unconfined"] + 0 }' "$profiles"`
      enforce=$1 complain=$2 unconfined=$3
      names=`$SED -n 's/ (complain)$//p' "$profiles" | $AWK '{ printf "%s%s", (NR > 1 ? ", " : ""), $0 }'`
      if [ "$enforce" -eq 0 ]; then
        message WARN mac001w "AppArmor is active, but no profile is in enforce mode ($complain in complain mode, $unconfined unconfined)." "No mandatory access control is enforcing: a compromised service can reach everything its user can."
      else
        trail=
        [ "$complain" -gt 0 ] && trail="In complain mode, which logs and does not deny: $names."
        p=profiles; [ "$enforce" -eq 1 ] && p=profile
        message INFO mac003i "$trail" "AppArmor is enforcing $enforce $p ($complain in complain mode, $unconfined unconfined)."
      fi
    fi
    ;;
  *)
    [ -z "$sawtomoyo" ] && message WARN mac001w "Neither AppArmor nor SELinux is active (security modules: ${lsm:-none listed})." "No mandatory access control is enforcing: a compromised service can reach everything its user can."
    ;;
esac

exit 0
