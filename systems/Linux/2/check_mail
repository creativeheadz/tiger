#
# check_mail: Postfix, Exim and Dovecot, from their configuration
#             files alone: no server is queried. Passwords that cross
#             in clear (SASL or plaintext authenticators with no TLS
#             to protect them, Dovecot with plaintext allowed or TLS
#             off) belong to whoever listens (mail001w). A relay open
#             to the world sends spam in your name (mail002w). A banner
#             carrying the version tells attackers what to try
#             (mail003i). Sendmail stays in check_sendmail, its
#             historic home. No mail config files means no mail here,
#             and there is nothing to say.
#
# 10/09/2026 - Initial version. Postfix main.cf; Exim's generated
#             config, else its conf.d fragments in order, else
#             exim.conf; dovecot.conf with its !includes expanded.
#             What is not set is not judged, except the banners:
#             Postfix and Exim disclose the version by default.
#
# References:
#   postconf(5)
#   exim(8)
#   doveconf(1)
#
# Tigris: offline
#   the root's mail configs, includes expanded inside the root.
#
#-----------------------------------------------------------------------------
#
TigerInstallDir='.'

#
# Set default base directory.
# Order or preference:
#      -B option
#      TIGERHOMEDIR environment variable
#      TigerInstallDir installed location
#
basedir=${TIGERHOMEDIR:=$TigerInstallDir}

for parm
do
   case $parm in
   -B) basedir=$2; break;;
   esac
done

#
# Verify that a config file exists there, and if it does
# source it.
#
[ ! -r $basedir/config ] && {
  echo "--ERROR-- [init002e] No 'config' file in \`$basedir'."
  exit 1
}

. $basedir/config

. $BASEDIR/initdefs
#
# If run in test mode (-t) this will verify that all required
# elements are set.
#
[ "$Tiger_TESTMODE" = 'Y' ] && {
  haveallcmds AWK CAT FIND GREP LS SED SORT || exit 1
  haveallfiles BASEDIR WORKDIR || exit 1

  echo "--CONFIG-- [init003c] $0: Configuration ok..."
  exit 0
}

#------------------------------------------------------------------------

haveallcmds AWK CAT FIND GREP LS SED SORT || exit 1

# expand_mail FILE DEPTH: FILE (an audited-system path) with its
# !include and !include_try lines expanded in place, read inside the
# root. Globs resolve against the audited system; relative names
# against the file that names them.
expand_mail()
{
  (
  __f=$1 __d=$2
  __h=`rootfile "$__f"`
  [ -f "$__h" ] && [ "$__d" -le 8 ] || exit 0
  while IFS= read -r __l || [ -n "$__l" ]
  do
    __inc=
    case "$__l" in
      '!include'[\ \	]*|'!include_try'[\ \	]*)
        __inc=`printf '%s' "$__l" | $SED 's/^![a-z_]*[ 	][ 	]*//; s/[ 	]*$//'` ;;
    esac
    if [ -z "$__inc" ]; then
      printf '%s\n' "$__l"
      continue
    fi
    case "$__inc" in /*) ;; *) __inc=${__f%/*}/$__inc ;; esac
    case "$__inc" in
      *[\*\?[]*)
        __dir=${__inc%/*} __pat=${__inc##*/}
        rootls "$__dir" 2>/dev/null | $SORT | while IFS= read -r __n
        do
          case "${__n##*/}" in $__pat) expand_mail "$__n" `expr $__d + 1` ;; esac
        done ;;
      *) expand_mail "$__inc" `expr $__d + 1` ;;
    esac
  done < "$__h"
  )
}

# stripped: comments cut (# and // styles), blanks dropped
stripped()
{
  $AWK '{ sub(/#.*$/, ""); sub(/\/\/.*$/, ""); if ($0 ~ /[^ \t]/) print }' "$1" 2>/dev/null
}

# existing_sys: the existing files among the arguments, one per line
existing_sys()
{
  for __f
  do
    [ -f "`rootfile $__f`" ] && echo "$__f"
  done
}

postfix=`existing_sys /etc/postfix/main.cf`
eximgen=`existing_sys /var/lib/exim4/config.autogenerated`
eximconf=`existing_sys /etc/exim/exim.conf`
dovecot=`existing_sys /etc/dovecot/dovecot.conf`

# No mail config files: no mail here
[ -z "$postfix$eximgen$eximconf$dovecot" ] && [ ! -d "`rootfile /etc/exim4/conf.d`" ] && exit 0

echo
echo "# Checking the mail configuration..."

# Postfix: SASL in clear, the world's relay, the versioned banner
for c in $postfix
do
  sasl= tlslevel= secropts= tlsauthonly= networks= banner= bannerset=
  stripped "`rootfile $c`" | $AWK '
    { line = $0; sub(/#.*/, "", line)
      if (line ~ /=/) { k = line; sub(/=.*/, "", k); v = line; sub(/^[^=]*=/, "", v)
        gsub(/^[ \t]+|[ \t]+$/, "", k); gsub(/^[ \t]+|[ \t]+$/, "", v)
        if (k != "") print tolower(k) "\t" v } }' | {
    while IFS='	' read -r k v
    do
      case "$k" in
        smtpd_sasl_auth_enable) case "`printf '%s' "$v" | tr 'A-Z' 'a-z'`" in yes|true|1) sasl=Y ;; esac ;;
        smtpd_tls_security_level) tlslevel=`printf '%s' "$v" | tr 'A-Z' 'a-z'` ;;
        smtpd_sasl_security_options) secropts=`printf '%s' "$v" | tr 'A-Z' 'a-z'` ;;
        smtpd_tls_auth_only) case "`printf '%s' "$v" | tr 'A-Z' 'a-z'`" in yes|true|1) tlsauthonly=Y ;; esac ;;
        mynetworks) networks="$networks $v" ;;
        smtpd_banner) banner=$v; bannerset=Y ;;
      esac
    done
    if [ -n "$sasl" ]; then
      case "$tlslevel" in encrypt|dane*|fingerprint|verify|secure) ;; *)
        [ -n "$tlsauthonly" ] || case ",$secropts," in *,noplaintext,*|*,noanonymous,*) ;; *)
          message WARN mail001w "Offer AUTH only under TLS ('smtpd_tls_auth_only = yes', or 'smtpd_sasl_security_options = noplaintext'), in $c." "Postfix offers SMTP AUTH with nothing protecting it ($c): the passwords cross in clear to whoever listens." ;; esac ;;
      esac
    fi
    case "$networks" in *0.0.0.0/0*) message WARN mail002w "Take the world out of mynetworks in $c: name only the networks that relay through here." "Postfix relays for the whole world (mynetworks in $c holds 0.0.0.0/0): spam goes out in your name." ;; esac
    if [ -z "$bannerset" ]; then
      message INFO mail003i "" "Postfix advertises its version: the default smtpd_banner carries \$mail_version. Set a banner of your own naming nothing."
    else
      case "$banner" in *mail_version*|*[0-9]*.[0-9]*) message INFO mail003i "" "Postfix advertises its version (smtpd_banner in $c). Set a banner naming nothing." ;; esac
    fi
  }
done

# Exim: the generated config where it exists, else the conf.d
# fragments in order, else exim.conf. One stream, scanned once.
eximstream=
if [ -n "$eximgen" ]; then
  eximstream="`rootfile $eximgen`"
else
  eximfragdir=`rootfile /etc/exim4/conf.d`
  if [ -d "$eximfragdir" ]; then
    # fragments carry no suffix; dotfiles and backups are not config
    # shellcheck disable=SC2046
    eximstream=`$FIND "$eximfragdir" -type f 2>/dev/null | $GREP -v '/\.' | $GREP -v '~$' | $SORT`
  elif [ -n "$eximconf" ]; then
    eximstream="`rootfile $eximconf`"
  fi
fi
if [ -n "$eximstream" ]; then
  # shellcheck disable=SC2046
  $CAT /dev/null $eximstream 2>/dev/null | $AWK '
    /^[ \t]*#/ { next }
    { line = tolower($0); sub(/#.*/, "", line)
      if (line ~ /^begin[ \t]+authenticators/) { inauth = 1; next }
      if (line ~ /^begin[ \t]+/) { inauth = 0; next }
      if (inauth && line ~ /^[ \t]*driver[ \t]*=[ \t]*plaintext/) plain = 1
      if (line ~ /server_advertise_condition/ && line ~ /tls_in_cipher|tls_bits|encrypted/) gate = 1
      if (line ~ /hostlist[ \t]+relay_from_hosts/) {
        v = line; sub(/^.*=/, "", v)
        n = split(v, hosts, /[ \t:;<>]+/)
        for (i = 1; i <= n; i++) if (hosts[i] == "*") relay = 1
      }
      if (line ~ /^[ \t]*smtp_banner[ \t]*=/) {
        bannerset = 1
        if (line ~ /[0-9]+\.[0-9]+/) bannerver = 1
      }
    }
    END {
      if (plain && !gate) print "clear-auth"
      if (relay) print "relay-world"
      if (!bannerset) print "banner-default"
      else if (bannerver) print "banner-version"
    }' | {
    while IFS= read -r fact
    do
      case "$fact" in
        clear-auth) message WARN mail001w "Advertise plaintext authenticators only under TLS (a server_advertise_condition on the cipher), in the Exim configuration." "Exim offers plaintext AUTH with nothing requiring TLS: the passwords cross in clear to whoever listens." ;;
        relay-world) message WARN mail002w "Take the wildcard out of relay_from_hosts in the Exim configuration: name only the networks that relay through here." "Exim relays for the whole world: spam goes out in your name." ;;
        banner-default) message INFO mail003i "" "Exim advertises its version: the default smtp_banner carries it. Set a banner of your own naming nothing." ;;
        banner-version) message INFO mail003i "" "Exim advertises its version (smtp_banner in its configuration). Set a banner naming nothing." ;;
      esac
    done
  }
fi

# Dovecot: the configuration with its includes expanded
for c in $dovecot
do
  expand_mail "$c" 0 | $AWK '
    /^[ \t]*#/ { next }
    { line = $0; sub(/#.*/, "", line)
      # protocol blocks tune one service; only the top level counts
      if (depth == 0 && line ~ /=/) {
        k = line; sub(/=.*/, "", k); v = line; sub(/^[^=]*=/, "", v)
        gsub(/^[ \t]+|[ \t]+$/, "", k); gsub(/^[ \t]+|[ \t]+$/, "", v)
        lk = tolower(k); lv = tolower(v)
        if (lk == "disable_plaintext_auth") plaintext = lv
        else if (lk == "ssl" && lv != "") dovessl = lv
        else if (lk == "login_greeting" && v ~ /[0-9]+\.[0-9]+/) greeting = 1
      }
      depth += gsub(/{/, "{", line) - gsub(/}/, "}", line)
      if (depth < 0) depth = 0
    }
    END {
      if (plaintext == "no" || dovessl == "no") print "clear-auth"
      if (greeting) print "banner-version"
    }' | {
    while IFS= read -r fact
    do
      case "$fact" in
        clear-auth) message WARN mail001w "Turn plaintext authentication off and TLS on in $c (disable_plaintext_auth = yes, ssl = yes)." "Dovecot takes passwords in clear ($c): whoever listens owns the mailboxes." ;;
        banner-version) message INFO mail003i "" "Dovecot advertises its version (login_greeting in $c). Set a greeting naming nothing." ;;
      esac
    done
  }
done

exit 0
