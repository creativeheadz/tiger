    print "<p class=\"crumbs\"><a href=\"./\">Findings</a> &rsaquo; <a href=\"./#" cat[id] "\">" esc(cat[id]) "</a></p>" > p
    print "<h1><code>" id "</code> " badges(sev[id]) "</h1>" > p
    print "<dl class=\"meta\"><dt>Category</dt><dd><a href=\"./#" cat[id] "\">" esc(cat[id]) "</a></dd>" > p
    print "<dt>Reported by</dt><dd><code>" esc(chk[id]) "</code></dd>" > p
    if (fix[id] != "") print "<dt>Fix</dt><dd>" esc(fix[id]) "</dd>" > p
    if (ref[id] != "") print "<dt>References</dt><dd>" esc(ref[id]) "</dd>" > p
    print "</dl>" > p
    if (cl1 != "") print "<h2>Compliance controls</h2><dl class=\"meta\">" cl1 "</dl>" > p
    print "<h2>What it means</h2>" > p
    printf "%s", body(text[id]) > p
    print "<p class=\"cmd\"><code>tigris explain " id "</code> shows this on the command line.</p>" > p
    foot("../")
    close(p)
  }

  # the findings index, by category, with a filter
  p = out "/findings/index.html"; dest = p
  head("Tigris findings", "../", "Every finding id Tigris reports: what it means, how to fix it, and the compliance controls it is evidence about.")
  print "<h1>Findings</h1>" > p
  printf "<p>%d finding ids in %d categories. Each says what was found, why it matters, what to do about it and which compliance controls it is evidence about; <code>tigris explain ID</code> shows the same.</p>\n", nid, nc > p
  print "<input id=\"q\" type=\"search\" placeholder=\"Filter by id, word, level or control\" aria-label=\"Filter the findings\" autofocus>" > p
  printf "<p class=\"cats\">" > p
  for (i = 1; i <= nc; i++) printf "<a href=\"#%s\">%s</a> <span class=\"n\">%d</span> ", cats[i], esc(cats[i]), ncat[cats[i]] > p
  print "</p>" > p
  for (i = 1; i <= nc; i++) {
    c = cats[i]
    print "<section class=\"cat\"><h2 id=\"" c "\">" esc(c) " <span class=\"n\">" ncat[c] "</span></h2><div class=\"table\"><table class=\"ids\"><tbody>" > p
    for (j = 1; j <= nid; j++) {
      id = ids[j]; if (cat[id] != c) continue
      d = (fix[id] != "" ? fix[id] : first(text[id]))
      sk = tolower(id " " sev[id] " " c " " d " " ctl[id] " " first(text[id])); gsub(/"/, "", sk)
      print "<tr data-s=\"" esc(sk) "\"><td class=\"id\"><a href=\"" id ".html\"><code>" id "</code></a></td><td class=\"sev\">" badges(sev[id]) "</td><td>" esc(d) "</td></tr>" > p
    }
    print "</tbody></table></div></section>" > p
  }
  print "<script>var q=document.getElementById(\"q\");q.addEventListener(\"input\",function(){var v=q.value.toLowerCase().trim();document.querySelectorAll(\"tr[data-s]\").forEach(function(r){r.hidden=v!==\"\"&&r.getAttribute(\"data-s\").indexOf(v)<0});document.querySelectorAll(\"section.cat\").forEach(function(s){s.hidden=!s.querySelector(\"tr[data-s]:not([hidden])\")})});</script>" > p
  foot("../")
  close(p)

  # a page per framework, and their index
  for (a = 1; a <= 4; a++) {
    fw = fws[a]; p = out "/compliance/" fwfile[fw] ".html"; n = ncl[fw]; dest = p
    for (i = 1; i <= n; i++) { cc[i] = cl[fw, i]; kk[i] = natkey(cc[i]) }
    sortby(cc, kk, n)
    head("Tigris and " fwname[fw], "../", "Which Tigris findings are evidence about each " fwname[fw] " control.")
    print "<p class=\"crumbs\"><a href=\"./\">Compliance</a></p>" > p
    print "<h1>" esc(fwname[fw]) "</h1>" > p
    printf "<p>%d controls with Tigris findings that are evidence about them. A finding is evidence for an assessment, not a verdict on a control: most controls ask for things no tool on one host can see.</p>\n", n > p
    print "<div class=\"table\"><table class=\"ctl\"><thead><tr><th>Control</th><th>Findings</th></tr></thead><tbody>" > p
    for (i = 1; i <= n; i++) {
      m = split(substr(cids[fw, cc[i]], 2), it, " "); s = ""
      for (b = 1; b <= m; b++) s = s "<a href=\"../findings/" it[b] ".html\"><code>" it[b] "</code></a> "
      print "<tr id=\"" anchor(cc[i]) "\"><td class=\"id\">" esc(cc[i]) "</td><td>" s "</td></tr>" > p
    }
    print "</tbody></table></div>" > p
    foot("../"); close(p)
    nctl[fw] = n
  }
  p = out "/compliance/index.html"; dest = p
  head("Tigris compliance mapping", "../", "Tigris maps every finding to CIS Controls v8, NIST SP 800-53, ISO/IEC 27001:2022 and UK Cyber Essentials, free and in the open.")
  print "<h1>Compliance mapping</h1>" > p
  print "<p>Every finding maps to the controls it is evidence about in four frameworks, free and in the open; the JSON report carries them with each finding. The map is one reviewable file, <a href=\"" repo "/blob/master/doc/controls.map\"><code>doc/controls.map</code></a>.</p>" > p
  print "<div class=\"table\"><table><thead><tr><th>Framework</th><th class=\"r\">Controls</th></tr></thead><tbody>" > p
  for (a = 1; a <= 4; a++) print "<tr><td><a href=\"" fwfile[fws[a]] ".html\">" esc(fwname[fws[a]]) "</a></td><td class=\"r\">" nctl[fws[a]] "</td></tr>" > p
  print "</tbody></table></div>" > p
  foot("../"); close(p)
}' || exit 2
exit 0
