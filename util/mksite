# a key that sorts numbers as numbers: 4.10 after 4.9, AC-12 after AC-2
function natkey(s,   k) {
  k = ""
  while (match(s, /[0-9]+/)) { k = k substr(s, 1, RSTART - 1) sprintf("%06d", substr(s, RSTART, RLENGTH) + 0); s = substr(s, RSTART + RLENGTH) }
  return k s
}
# a[1..n] sorted by the keys in k[1..n] (insertion sort: lists are short)
function sortby(a, k, n,   i, j, ta, tk) {
  for (i = 2; i <= n; i++) {
    ta = a[i]; tk = k[i]
    for (j = i - 1; j >= 1 && k[j] > tk; j--) { a[j + 1] = a[j]; k[j + 1] = k[j] }
    a[j + 1] = ta; k[j + 1] = tk
  }
}
function anchor(s) { s = tolower(s); gsub(/[^a-z0-9]+/, "-", s); sub(/^-/, "", s); sub(/-$/, "", s); return "c-" s }
function badges(s,   n, l, i, o) {
  n = split(s, l, /, */); o = ""
  for (i = 1; i <= n; i++) if (l[i] != "") o = o "<span class=\"badge " l[i] "\">" l[i] "</span>"
  return o
}
# ids named in a text, linked to their pages
function linkids(s, pre,   out, m, b, a) {
  out = ""
  while (match(s, /[a-z][a-z]*[0-9][0-9][0-9][acefiw]/)) {
    m = substr(s, RSTART, RLENGTH)
    b = (RSTART > 1 ? substr(s, RSTART - 1, 1) : " "); a = substr(s, RSTART + RLENGTH, 1)
    if ((m in sev) && b !~ /[A-Za-z0-9_\/.-]/ && a !~ /[A-Za-z0-9_]/) out = out substr(s, 1, RSTART - 1) "<a href=\"" pre m ".html\">" m "</a>"
    else out = out substr(s, 1, RSTART + RLENGTH - 1)
    s = substr(s, RSTART + RLENGTH)
  }
  return out s
}
# the explanation: paragraphs, and indented lines as they are
function body(t,   n, l, i, o, mode, buf, m) {
  n = split(t, l, "\n"); o = ""; mode = ""; buf = ""
  for (i = 1; i <= n; i++) {
    if (l[i] ~ /^[ \t]*$/) { o = o emit(mode, buf); mode = ""; buf = ""; continue }
    m = (l[i] ~ /^[ \t]/ ? "pre" : "p")
    if (m != mode) { o = o emit(mode, buf); mode = m; buf = "" }
    buf = buf (buf == "" ? "" : (m == "pre" ? "\n" : " ")) l[i]
  }
  return o emit(mode, buf)
}
function emit(mode, buf) {
  if (mode == "p") return "<p>" linkids(esc(buf), "") "</p>\n"
  if (mode == "pre") return "<pre>" esc(buf) "</pre>\n"
  return ""
}
# the first sentence of the explanation, for titles and descriptions
function first(t,   s, i) {
  s = t; gsub(/\n/, " ", s); sub(/^ +/, "", s); gsub(/  +/, " ", s)
  if (match(s, /[.] /)) s = substr(s, 1, RSTART)
  if (length(s) > 120) { s = substr(s, 1, 120); i = 120; while (i > 60 && substr(s, i, 1) != " ") i--; s = substr(s, 1, i - 1) "..." }
  sub(/[:;,]$/, "", s)
  return s
}
{
  file = $0; id = file; sub(/.*\//, "", id); hd = 1; txt = ""
  while ((getline line < file) > 0) {
    if (hd && line == "") { hd = 0; continue }
    if (hd) { k = line; sub(/:.*/, "", k); v = line; sub(/^[^:]*: ?/, "", v); f[k] = v; continue }
    txt = txt line "\n"
  }
  close(file)
  ids[++nid] = id; sev[id] = f["Severity"]; cat[id] = f["Category"]; chk[id] = f["Check"]
  fix[id] = f["Fix"]; ref[id] = f["References"]; ctl[id] = f["Controls"]; text[id] = txt
  split("", f)
  if (!(cat[id] in ncat)) cats[++nc] = cat[id]
  ncat[cat[id]]++
  # the controls: "CIS 4.1, 4.2; NIST AC-3; ISO 8.9; CE Secure configuration"
  n = split(ctl[id], g, /; */)
  for (i = 1; i <= n; i++) {
