# What every page shares: escaping, the head and the foot. Pages one
# level down pass root="../", the others "./".
LIB='
function esc(s) { gsub(/&/, "\\&amp;", s); gsub(/</, "\\&lt;", s); gsub(/>/, "\\&gt;", s); gsub(/"/, "\\&quot;", s); return s }
# one line of a page, to dest when it is set, else to standard output
function o(l) { if (dest == "") print l; else print l > dest }
function head(title, root, desc) {
  o("<!DOCTYPE html>")
  o("<html lang=\"en\"><head><meta charset=\"utf-8\">")
  o("<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">")
  o("<title>" esc(title) "</title>")
  o("<meta name=\"description\" content=\"" esc(desc) "\">")
  o("<meta property=\"og:title\" content=\"" esc(title) "\">")
  o("<meta property=\"og:description\" content=\"" esc(desc) "\">")
  o("<meta property=\"og:image\" content=\"" site "art/social.png\">")
  o("<link rel=\"stylesheet\" href=\"" root "style.css\">")
  o("<link rel=\"icon\" href=\"" root "art/tiger.png\">")
  o("</head><body>")
  o("<header class=\"nav\"><a class=\"brand\" href=\"" root "\"><img src=\"" root "art/tiger.png\" alt=\"\">TIGRIS</a>")
  o("<nav><a href=\"" root "findings/\">Findings</a><a href=\"" root "compliance/\">Compliance</a><a href=\"" root "json-format.html\">JSON</a><a href=\"" repo "/releases/latest\">Download</a><a href=\"" repo "\">GitHub</a></nav></header>")
  o("<main>")
}
function foot(root) {
  o("</main>")
  o("<footer>Tigris " esc(ver) " &middot; GPL-2.0-or-later &middot; descended from <a href=\"https://savannah.nongnu.org/projects/tiger/\">TIGER</a> (Texas A&amp;M, 1993) &middot; <a href=\"" repo "\">source</a> &middot; <a href=\"" root "findings/\">findings</a></footer>")
  o("</body></html>")
}
