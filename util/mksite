# The markdown pages
MD='
function slug(s) { s = tolower(s); gsub(/`/, "", s); gsub(/[^a-z0-9 _-]/, "", s); gsub(/ /, "-", s); return s }
# where a link points from the page: anchors and URLs as they are, the
# documents the site renders to their pages, anything else to GitHub
function href(u,   p) {
  if (u ~ /^(https?:|mailto:|#)/) return u
  p = (dir == "" ? u : dir "/" u)
  sub(/\/$/, "", p)
  if (p == "doc/json-format.md") return "json-format.html"
  if (p == "doc/metadata.md") return "metadata.html"
  if (p == "doc/tigris-report.schema.json") return "schema/tigris-report.schema.json"
  if (p == "meta") return "findings/"
  if (p ~ /^art\/[a-z-]+\.png$/) return p
  return repo "/blob/master/" p
}
# bold, italics and <url>s in a run of plain text
function fmt(s,   u) {
  s = esc(s)
  while (match(s, /[*][*][^*]+[*][*]/)) s = substr(s, 1, RSTART - 1) "<b>" substr(s, RSTART + 2, RLENGTH - 4) "</b>" substr(s, RSTART + RLENGTH)
  while (match(s, /[*][^* ][^*]*[*]/)) s = substr(s, 1, RSTART - 1) "<em>" substr(s, RSTART + 1, RLENGTH - 2) "</em>" substr(s, RSTART + RLENGTH)
  while (match(s, /&lt;https?:[^ &]*&gt;/)) { u = substr(s, RSTART + 4, RLENGTH - 8); s = substr(s, 1, RSTART - 1) "<a href=\"" u "\">" u "</a>" substr(s, RSTART + RLENGTH) }
  return s
}
# a line of text: code spans as they are, links and images, the rest fmt
function inline(s,   out, j, k, t, rest, u, url, img, r) {
  out = ""
  while (s != "") {
    if (!match(s, /`|\[|!\[/)) { out = out fmt(s); break }
    # fmt() calls match() too: keep where this one matched
    r = RSTART
    out = out fmt(substr(s, 1, r - 1)); s = substr(s, r)
    if (substr(s, 1, 1) == "`") {
      j = index(substr(s, 2), "`")
      if (j) { out = out "<code>" esc(substr(s, 2, j - 1)) "</code>"; s = substr(s, j + 2); continue }
      out = out "`"; s = substr(s, 2); continue
    }
    img = (substr(s, 1, 1) == "!"); k = (img ? 2 : 1)
    j = index(substr(s, k + 1), "](")
    if (j) {
      t = substr(s, k + 1, j - 1); rest = substr(s, k + j + 2); u = index(rest, ")")
      if (u) {
        url = substr(rest, 1, u - 1)
        if (img) out = out "<img src=\"" href(url) "\" alt=\"" esc(t) "\">"
        else out = out "<a href=\"" href(url) "\">" inline(t) "</a>"
        s = substr(rest, u + 1); continue
      }
    }
    out = out esc(substr(s, 1, k)); s = substr(s, k + 1)
  }
  return out
}
# the cells of a table row, split on | outside code spans
function cells(line, c,   n, i, ch, code, cur) {
  sub(/^[ \t]*[|]/, "", line); sub(/[|][ \t]*$/, "", line)
  n = 0; cur = ""; code = 0
  for (i = 1; i <= length(line); i++) {
    ch = substr(line, i, 1)
    if (ch == "`") code = !code
    if (ch == "|" && !code) { c[++n] = cur; cur = ""; continue }
    cur = cur ch
  }
  c[++n] = cur
  for (i = 1; i <= n; i++) { sub(/^[ \t]+/, "", c[i]); sub(/[ \t]+$/, "", c[i]) }
  return n
}
function flushpara() { if (para != "") { print "<p>" inline(para) "</p>"; para = "" } }
function flushitem() { if (item != "") { print "<li>" inline(item) "</li>"; item = "" } }
function closelist() { flushitem(); if (list != "") { print "</" list ">"; list = "" } }
function closetable() { if (trows) { print "</tbody></table></div>"; trows = 0 } }
function flushall() { flushpara(); closelist(); closetable() }
# raw HTML: relative links pointed where href() says
function raw(l,   out, u, r, n) {
  out = ""
  while (match(l, /href="[^"#][^"]*"/)) {
    r = RSTART; n = RLENGTH
    u = substr(l, r + 6, n - 7)
    out = out substr(l, 1, r - 1) "href=\"" href(u) "\""
    l = substr(l, r + n)
  }
  return out l
}
BEGIN { head(title, "./", desc) }
infence {
  if ($0 ~ /^```/) { print "</code></pre>"; infence = 0 } else print esc($0)
  next
}
/^```/ { flushall(); printf "<pre><code>"; infence = 1; first = 1; next }
inraw {
  if ($0 ~ /^[ \t]*$/) { inraw = 0; next }
  print raw($0); next
}
/^[ \t]*$/ { flushpara(); closelist(); closetable(); next }
/^#+ / {
  flushall()
  n = index($0, " ") - 1; t = substr($0, n + 2)
  print "<h" n " id=\"" slug(t) "\">" inline(t) "</h" n ">"; next
}
/^---+[ \t]*$/ { flushall(); print "<hr>"; next }
/^[ \t]*[|]/ {
  flushpara(); closelist()
  n = cells($0, c)
  if (!trows) {
    for (i = 1; i <= n; i++) hdr[i] = c[i]
    nh = n; trows = -1; next
  }
  if (trows == -1) {
    printf "<div class=\"table\"><table><thead><tr>"
    for (i = 1; i <= nh; i++) {
      al[i] = (c[i] ~ /^:.*:$/ ? " class=\"c\"" : (c[i] ~ /:$/ ? " class=\"r\"" : ""))
      printf "<th%s>%s</th>", al[i], inline(hdr[i])
    }
    print "</tr></thead><tbody>"; trows = 1; next
  }
  printf "<tr>"
  for (i = 1; i <= nh; i++) printf "<td%s>%s</td>", al[i], inline(c[i])
  print "</tr>"; next
}
/^[ \t]*</ && para == "" && item == "" { flushall(); inraw = 1; print raw($0); next }
/^([-*]|[0-9]+[.]) / {
  flushpara(); closetable()
  t = ($0 ~ /^[-*] / ? "ul" : "ol")
  if (list != t) { closelist(); print "<" t ">"; list = t }
  flushitem()
  item = $0; sub(/^([-*]|[0-9]+[.]) /, "", item); next
}
list != "" && /^[ \t]+[^ \t]/ { t = $0; sub(/^[ \t]+/, "", t); item = item " " t; next }
{ closelist(); closetable(); para = para (para == "" ? "" : " ") $0 }
END { if (infence) print "</code></pre>"; flushall(); foot("./") }
'

