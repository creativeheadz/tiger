#
# Profile "container": run inside a container (or against a container
# image's root), where the kernel, the boot, the firewall, systemd and the
# disks belong to the host and are not this system's to judge. What stays
# is what the image itself holds: packages and their integrity, pending
# security updates, accounts, sudo, PAM, file permissions, setuid files.
#
#   ./tigris --profile container
#
# Read after the tigerrc; only what differs from it.
#
Tiger_Check_BOOT=N
Tiger_Check_SINGLE=N
Tiger_Check_RCUMASK=N
Tiger_Check_NETWORKCONFIG=N
Tiger_Check_SYSCTL=N
Tiger_Check_SYSTEMD=N
Tiger_Check_FIREWALL=N
Tiger_Check_SECUREBOOT=N
Tiger_Check_MAC=N
Tiger_Check_AUDIT=N
Tiger_Check_TIMESYNC=N
Tiger_Check_UNITS=N
Tiger_Check_STORAGE=N
Tiger_Check_CONTAINERS=N
Tiger_Check_ROOTKIT=N
