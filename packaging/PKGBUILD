# Maintainer: Andrei Trimbitas <a.trimbitas@oldforge.tech>
pkgname=tigris
pkgver=3.8.0
pkgrel=1
pkgdesc='Security auditor for Linux, macOS and the BSDs, descended from TIGER'
arch=('x86_64' 'aarch64')
url='https://github.com/creativeheadz/tigris'
license=('GPL-2.0-or-later')
makedepends=('gcc' 'make')
backup=('etc/tigris/tigerrc' 'etc/tigris/cronrc')
source=("$pkgname-$pkgver.tar.gz::https://github.com/creativeheadz/tigris/archive/refs/tags/version_${pkgver//./_}.tar.gz")
# SKIP until the tag exists: the sum of the tag's tarball is put here, and
# .SRCINFO regenerated, in the commit after the release (packaging/README.md)
sha256sums=('SKIP')

build() {
	cd "$srcdir/$pkgname-version_${pkgver//./_}"
	./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var \
		--with-tigerhome=/usr/lib/tigris \
		--with-tigerconfig=/etc/tigris \
		--with-tigerwork=/var/lib/tigris \
		--with-tigerlog=/var/log/tigris \
		--with-tigerbin=/usr/bin
	make
}

package() {
	cd "$srcdir/$pkgname-version_${pkgver//./_}"
	make install DESTDIR="$pkgdir"
	sh packaging/stage.sh "$pkgdir" /usr/lib/tigris /usr/bin
}
