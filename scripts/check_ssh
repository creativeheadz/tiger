#    This program is distributed in the hope that it will be useful,
#    but WITHOUT ANY WARRANTY; without even the implied warranty of
#    MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
#    GNU General Public License for more details.
#
#     Please see the file `COPYING' for the complete copyright notice.
#
# check_ssh - Checks for configuration directives in the SSH configuration
#             file.
#
# 10/07/2026 - atrimbitas - Auditing an offline root (--root), sshd is not
#             run (it would be this host's, reading this host's keys): the
#             effective configuration is worked out from the root's
#             sshd_config as sshd would, Include files read in place
#             (relative ones from /etc/ssh), the first value of a keyword
#             kept, Match blocks set aside, OpenSSH's defaults for what is
#             not set (no UsePAM where sshd has no PAM stack: Alpine), and
#             checked as sshd -T's output is.
# 01/07/2004 - rbrad - Applied Savannah Patch: 2439 to make POSIX compliant.
# 11/19/2003 - jfs - This script is not POSIX compliant (yet)
# 09/19/2003 - jfs - Applied patch from Ryan Braderitch fixing typoes (sp?)
# 09/03/2003 - jfs - Removed PermitRootLogin since that's checked by check_root
#             (and belongs there, IMHO) also added failsafe checks for 
#             SSHD_CONFIG which might not be configured in some systems
# 06/30/2003 - rbradetich@uswest.net - first release
#
# TODO:
#   - Add additional directives that can be checked.
#   - Figure out a clever method for integrating the default checks with the
#     normal checks.
#   - Currently suited for OpenSSH needs to be tested with other SSH daemons
# Tigris: needs root
#   sshd -T needs root (it reads the host keys).
# Tigris: offline
#
#-----------------------------------------------------------------------------
#
TigerInstallDir='.'

#
# Set default base directory.
# Order or preference:
#      -B option
#      TIGERHOMEDIR environment variable
#      TigerInstallDir installed location
#
basedir=${TIGERHOMEDIR:=$TigerInstallDir}

for parm
do
   case $parm in
   -B) basedir=$2; break;;
   esac
done

#
# Verify that a config file exists there, and if it does
# source it.
#
[ ! -r $basedir/config ] && {
  echo "--ERROR-- [init002e] No 'config' file in \`$basedir'."
  exit 1
}

. $basedir/config

. $BASEDIR/initdefs

#
# If run in test mode (-t) this will verify that all required
# elements are set.
#
[ "$Tiger_TESTMODE" = 'Y' ] && {
  haveallfiles BASEDIR || exit 1
  
  echo "--CONFIG-- [init003c] $0: Configuration ok..."
  exit 0
}

#------------------------------------------------------------------------

echo
echo "# Checking sshd_config configuration files..."

haveallfiles BASEDIR || exit 1

#
# Parse the Protocol line and verify only allowed protocols are specified.
# Return 0 if the protocol is not in the approved protocol list, otherwise
# return 1.
#
parse_Protocol()
{
	line=$1

	[ -z "$Tiger_SSH_Protocol" ] && return 1
	while [ -n "$line" ]
	do
		proto=${line%%,*}
		line=${line##${proto}}
		line=${line##,}

		eval "case \"$proto\" in
			$Tiger_SSH_Protocol)
				;;
			*)
				return 0
				;;
		esac"
	done
	return 1
}

#
# Generic parsing routine for SSH Daemon directivies. 
# Return 0 if the value is not in the approved list, otherwise
# return 1.
#
parse_directive()
{
	value=$1
	list=$2

	[ -z "$list" ] && return 1
	eval "case \"$value\" in
		$list)
			return 1
			;;
		*)
			return 0
			;;
	esac"
}

#
# Parse the specified sshd_config file.
#
parse_sshd_config_file()
{
	# Declare some variables to see if specified attributes are specified
	# or if we need to check the defaults.
	found_Protocol=0
	found_RhostsAuthentication=0
	found_PasswordAuthentication=0

	while read line
	do
		line=${line%%\#*}
		key=${line%% *}
		line=${line##${key}}

		case "$key" in
			Protocol)
				found_Protocol=1
				parse_Protocol $line $1 && {
					message WARN ssh001w "" "Protocol $proto is enabled in $file"
				}	
				;;
				
			RhostsAuthentication)
				found_RhostsAuthentication=1
				parse_directive $line $Tiger_SSH_RhostsAuthentication && {
					message WARN ssh003w "" "The RhostsAuthentication directive in $1 is set to the unapproved value: $line."
				}
				;;

			PasswordAuthentication)
				found_PasswordAuthentication=1
				parse_directive $line $Tiger_SSH_PasswordAuthentication && {
					message WARN ssh004w "" "The PasswordAuthentication directive in $1 is set to the unapproved value: $line."
				}
				;;
		esac
	done < $1

	# Check the default values if the entry was not specified.
	[ $found_Protocol = 0 ] && parse_Protocol "2,1" && {
		message WARN ssh001w "" "Protocol $proto is enabled in $file"
	}
	[ $found_RhostsAuthentication = 0 ] && parse_directive "no" $Tiger_SSH_RhostsAuthentication && {
		message WARN ssh003w "" "The RhostsAuthentication directive in $1 is set to the unapproved default value: no."
	}
	[ $found_PasswordAuthentication = 0 ] && parse_directive "yes" $Tiger_SSH_PasswordAuthentication && {
		message WARN ssh004w "" "The PasswordAuthentication directive in $1 is set to the unapproved defult value: yes."
	}
}

# sshd_written FILE: sshd -T's output (lower case "keyword value" lines) as
# worked out from the configuration files of the system audited, without
# running sshd. expand_sshd FILE DEPTH writes FILE with each Include line
# replaced by the files it names, in their lexical order, every file
# between "#tigris-begin" and "#tigris-end" lines.
expand_sshd()
{
	(
	__f=$1 __d=$2
	__h=`rootfile "$__f"`
	[ -f "$__h" ] && [ "$__d" -le 16 ] || exit 0
	echo "#tigris-begin"
	$AWK '{ l = $0; sub(/^[ \t]+/, "", l)
		if (tolower(l) ~ /^include([ \t=]|$)/) { sub(/^[^ \t=]*[ \t]*=?[ \t]*/, "", l); print "#tigris-include " l }
		else print }' "$__h" |
	while IFS= read -r __l
	do
		case "$__l" in
		"#tigris-include "*)
			set -f
			for __p in ${__l#\#tigris-include }
			do
				set +f
				case "$__p" in /*) ;; *) __p=/etc/ssh/$__p ;; esac
				__dir=${__p%/*} __glob=${__p##*/}
				for __n in `rootls "${__dir:-/}" | $SED 's,.*/,,' | $SORT`
				do
					case "$__n" in $__glob) expand_sshd "$__dir/$__n" `expr $__d + 1` ;; esac
				done
				set -f
			done
			set +f
			;;
		*) printf '%s\n' "$__l" ;;
		esac
	done
	echo "#tigris-end"
	)
}
sshd_written()
{
	# An sshd built without PAM (Alpine's openssh) has no UsePAM at all;
	# one built with it has a PAM stack of its own
	__pam=0
	[ -f "`rootfile /etc/pam.d/sshd`" ] || [ -f "`rootfile /usr/lib/pam.d/sshd`" ] && __pam=1
	expand_sshd "$1" 0 |
	$AWK -v pam=$__pam '
	# a Match block holds until the next Match (or "Match all") or the
	# end of its file; an included file starts in its parent'"'"'s state
	$0 == "#tigris-begin" { stack[++sp] = inmatch; next }
	$0 == "#tigris-end" { inmatch = stack[sp--]; next }
	# LoginGraceTime and the like: 1m30s, 2m, 90
	function seconds(v,   t, n, u) {
		t = 0
		while (match(v, /^[0-9]+[smhdwSMHDW]?/)) {
			n = substr(v, 1, RLENGTH); v = substr(v, RLENGTH + 1)
			u = tolower(substr(n, length(n))); if (u ~ /[0-9]/) u = "s"; else n = substr(n, 1, length(n) - 1)
			t += n * (u == "m" ? 60 : u == "h" ? 3600 : u == "d" ? 86400 : u == "w" ? 604800 : 1)
		}
		return v == "" ? t : -1
	}
	{ sub(/#.*/, ""); sub(/^[ \t]+/, ""); sub(/[ \t]+$/, "")
	  if ($0 == "") next
	  k = $0; sub(/[ \t=].*/, "", k); v = substr($0, length(k) + 1); k = tolower(k)
	  sub(/^[ \t]*=?[ \t]*/, "", v); v = tolower(v)
	  if (k == "match") { inmatch = (v != "all"); next }
	  if (inmatch || (k == "usepam" && !pam)) next
	  if (k == "challengeresponseauthentication") k = "kbdinteractiveauthentication"
	  if (k == "logingracetime" && seconds(v) >= 0) v = seconds(v)
	  if (!(k in seen)) { seen[k]; print k " " v } }
	END {
	  n = split("passwordauthentication yes|permitrootlogin prohibit-password|permitemptypasswords no|x11forwarding no|maxauthtries 6|usepam no|kbdinteractiveauthentication yes|logingracetime 120|hostbasedauthentication no|ignorerhosts yes|permituserenvironment no|loglevel info", d, "|")
	  for (i = 1; i <= n; i++) { split(d[i], kv, " "); if (!(kv[1] in seen) && (pam || kv[1] != "usepam")) print d[i] } }'
}

# If SSHD_CONFIG is not defined we use some sane values
[ -z "$SSHD_CONFIG" ] && [ -z "$TIGRIS_ROOT" ] && {
if [ -f /usr/local/etc/sshd_config ]; then
  SSHD_CONFIG=/usr/local/etc/sshd_config
elif [ -f /etc/sshd_config ]; then
  SSHD_CONFIG=/etc/sshd_config
elif [ -f /etc/ssh2/sshd2_config ]; then
  SSHD_CONFIG=/etc/ssh2/sshd2_config
elif [ -f /etc/ssh/sshd_config ]; then
  SSHD_CONFIG=/etc/ssh/sshd_config
fi
}

#
# The effective configuration, as sshd itself resolves it: Include files,
# Match-free defaults and all. Needs a working sshd and (for its host keys)
# root; otherwise the text parsing below is used. Tiger_SSHD_Cmd lets the
# tests feed a fixture in sshd -T format.
#
effective=
sshd_cmd=${Tiger_SSHD_Cmd:-}
if [ -n "$TIGRIS_ROOT" ] && [ -z "$sshd_cmd" ]; then
	# An offline root's sshd_config (openSUSE ships its defaults in /usr/etc)
	for SSHD_CONFIG in /etc/ssh/sshd_config /usr/etc/ssh/sshd_config /usr/local/etc/sshd_config ''
	do
		[ -z "$SSHD_CONFIG" ] || [ -f "`rootfile $SSHD_CONFIG`" ] && break
	done
	# no sshd_config: no sshd to check
	[ -n "$SSHD_CONFIG" ] || exit 0
	effective=$WORKDIR/sshd.effective.$$
	safe_temp $effective
	sshd_written $SSHD_CONFIG > $effective
elif [ -z "$sshd_cmd" ]; then
	for d in /usr/sbin /usr/local/sbin /sbin
	do
		[ -x "$d/sshd" ] && { sshd_cmd="$d/sshd -T"; break; }
	done
	# A single configured file that is not the default: ask sshd about that one
	case "$SSHD_CONFIG" in
		''|/etc/ssh/sshd_config|*' '*) ;;
		*) [ -n "$sshd_cmd" ] && sshd_cmd="$sshd_cmd -f $SSHD_CONFIG" ;;
	esac
fi
if [ -z "$effective" ] && [ -n "$sshd_cmd" ]; then
	effective=$WORKDIR/sshd.effective.$$
	safe_temp $effective
	$sshd_cmd 2>/dev/null | $TR 'A-Z' 'a-z' > $effective
	[ -s "$effective" ] || { delete $effective; effective=; }
fi

# Value of one keyword in the effective configuration (lower case)
setting()
{
	$AWK -v k="$1" '$1 == k { $1 = ""; sub(/^ /, ""); print; exit }' $effective
}

if [ -n "$effective" ]; then
	if [ -n "$TIGRIS_ROOT" ] && [ -z "$Tiger_SSHD_Cmd" ]; then
		echo "# Checking the sshd configuration written in $SSHD_CONFIG and its Include files (sshd is not run on an offline root)..."
	else
		echo "# Checking the effective sshd configuration (sshd -T)..."
	fi
	# keyword, test, wanted, level, code, what the wrong value means.
	# 'is' takes a case pattern; 'le' a number the value must not exceed.
	while read key test want level code text
	do
		case "$key" in ''|\#*) continue ;; esac
		value=`setting $key`
		[ -z "$value" ] && continue
		ok=N
		case "$test" in
			is) eval "case \"\$value\" in $want) ok=Y ;; esac" ;;
			le) case "$value" in *[!0-9]*) ok=Y ;; *) [ "$value" -le "$want" ] && ok=Y ;; esac ;;
		esac
		[ "$ok" = N ] && message $level $code "" "sshd: $key is $value: $text"
	done <<EOF
passwordauthentication       is no                                                           WARN ssh004w passwords are accepted for login
permitrootlogin              is no|prohibit-password|without-password|forced-commands-only   FAIL ssh006f root may log in with a password
permitemptypasswords         is no                                                           FAIL ssh007f accounts with an empty password may log in
x11forwarding                is no                                                           WARN ssh008w X11 is forwarded, which exposes the client's display to this server
maxauthtries                 le 4                                                            WARN ssh009w more than four authentication attempts are allowed per connection
usepam                       is yes                                                          WARN ssh010w PAM is bypassed, so its account and session rules do not apply
kbdinteractiveauthentication is no                                                           WARN ssh011w keyboard-interactive login is open, which PAM can turn into a password prompt
logingracetime               le 60                                                           WARN ssh012w an unauthenticated connection may be held open for more than 60 seconds
hostbasedauthentication      is no                                                           WARN ssh013w hosts are trusted on the strength of their host key alone
ignorerhosts                 is yes                                                          WARN ssh014w .rhosts and .shosts files are consulted
permituserenvironment        is no                                                           WARN ssh015w users may set LD_PRELOAD and the like through authorized_keys
loglevel                     is info|verbose|debug|debug1|debug2|debug3                      WARN ssh016w logins are not logged in enough detail to investigate
EOF
	weak=`setting ciphers | $TR ',' '\n' | $GREP -E 'cbc|arcfour|rc4|3des|blowfish|cast128' | $TR '\n' ' '`
	[ -n "$weak" ] && message WARN ssh017w "" "sshd: weak ciphers are enabled: $weak"
	weak=`setting macs | $TR ',' '\n' | $GREP -E 'md5|-96$|-96-etm|ripemd' | $TR '\n' ' '`
	[ -n "$weak" ] && message WARN ssh018w "" "sshd: weak MACs are enabled: $weak"
	weak=`setting kexalgorithms | $TR ',' '\n' | $GREP -E 'diffie-hellman-group1-|diffie-hellman-group14-sha1|group-exchange-sha1' | $TR '\n' ' '`
	[ -n "$weak" ] && message WARN ssh019w "" "sshd: weak key exchange algorithms are enabled: $weak"
	delete $effective
	exit 0
fi

# Main loop, check all the specified sshd_config files.
if [ -n "$SSHD_CONFIG" ] 
then
	for file in $SSHD_CONFIG
	do
		[ -r "$file" ] && parse_sshd_config_file $file
	done
else
	message FAIL ssh005w "" "Cannot find a configuration file for SSH."
fi

exit 0
