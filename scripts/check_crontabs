#     Please see the file `COPYING' for the complete copyright notice.
#
# check_crontabs  - 06/14/93
#
# Ideas from Dan Farmer's 'cron.chk' from COPS 1.04.
# 
# check_crontabs  - 11/08/2007 - jfs Change message calls so that they can be
#                                    filtered (Debian bug #411534)
# check_crontabs  - 01/15/2004 - jfs Will only warn if neither cron.allow
#                                    nor cron.deny exists (Debian bug #226362)
# check_crontabs  - 11/19/2003 - jfs Introduce some more information on
#            allow/deny checks as suggested by unspawn.
# check_crontabs  - 08/19/2003 - jfs Renamed to check_crontabs
# check_crontabs  - 08/14/2003 - jfs Added OUTPUTMETHOD to dependancies 
#                            incorporated changes from ARSC tara version 3.0.3
# check_crontabs  - 08/13/2003 - jfs Fixed a call to grep and added lost changes
#                            made by ARSC
# check_crontabs  - 08/08/2003 - jfs Avoided race conditions in temporary file
#                            usage.
# check_crontabs  - 08/12/2002 - jfs Fixed to use CRONSPOOL
# check_crontabs  - 04/25/2002 - jfs Fixed dependancies
# check_crontabs  - 04/28/1999 Modified by Advanced Research Corp (R) to 
#                        correct errors
# check_crontabs  - 04/20/1999 Modified by Advanced Research Corp (R) to 
#                        correct errors
# check_crontabs  - 02/10/2018 - jfs - Clean up the cron output file befoe
#                        using as this might contain --ERROR-- or --WARN--
#                        messages from gen_cron which leads to interpretation
#                        problems (Debian bug #839635)
# check_crontabs  - 10/07/2026 - atrimbitas - Reads what gen_cron lists now:
#            /etc/crontab and cron.d too, and each file cron reads, reported
#            when others can write it (cron008) or it is not root's (or its
#            user's) own (cron009), and spool crontabs whose name is no
#            account (cron010), with ids instead of gen_cron's bare text.
#            Commands with "--" in them were dropped (the filter for those
#            texts), and the shell-script test compared this script's own
#            $2. A job's home comes from passwd rather than getuserhome's
#            bash -c "echo ~NAME", since the names now come from cron.d's
#            contents too. An offline root (--root) is read inside it,
#            owners named by its passwd.
# check_crontabs  - 10/09/2026 - at.allow and at.deny read the same way
#            (cron011w, cron012i); neither file means only root may use
#            at, so that is silence, not a warning.
#
# Tigris: offline
#   the root's crontabs, cron.d and spool, through gen_cron.
#
#-----------------------------------------------------------------------------
#
TigerInstallDir='.'

#
# Set default base directory.
# Order or preference:
#      -B option
#      TIGERHOMEDIR environment variable
#      TigerInstallDir installed location
#
basedir=${TIGERHOMEDIR:=$TigerInstallDir}

for parm
do
   case $parm in
   -B) basedir=$2; break;;
   esac
done

#
# Verify that a config file exists there, and if it does
# source it.
#
[ ! -r "$basedir/config" ] && {
  echo "--ERROR-- [init002e] No 'config' file in \`$basedir'."
  exit 1
}

. $basedir/config

. $BASEDIR/initdefs
#
# If run in test mode (-t) this will verify that all required
# elements are set.
#
[ "$Tiger_TESTMODE" = 'Y' ] && {
  haveallcmds AWK BASENAME CAT GEN_CRON_FILES LS MV RM TR SED GREP OUTPUTMETHOD || exit 1
  haveallfiles BASEDIR WORKDIR || exit 1
  
  echo "--CONFIG-- [init003c] $0: Configuration ok..."
  exit 0
}

#------------------------------------------------------------------------
echo
echo "# Performing check of \`cron' entries..."

haveallcmds AWK BASENAME CAT GEN_CRON_FILES LS RM TR SED GREP OUTPUTMETHOD || exit 1
haveallfiles BASEDIR WORKDIR || exit 1

safe_temp "$WORKDIR/cron.in.$$"
trap 'delete $WORKDIR/cron.in.$$ ; exit 1' 1 2 3 15

realpath="$REALPATH -d"
test ! -n "$REALPATH" -o ! $TESTEXEC "$REALPATH" && realpath=echo

# homeof USER: the user's home, from passwd (live, as the system resolves
# names; offline, the root's), and never from a shell asked for ~USER: the
# names come from crontabs, cron.d's user fields among them
homeof()
{
  if [ -z "$TIGRIS_ROOT" ] && [ -n "$GETENT" ]; then
    $GETENT passwd -- "$1" 2>/dev/null | $AWK -F: '{ print $6; exit }'
  else
    $AWK -F: -v u="$1" '$1 == u { print $6; exit }' "`rootfile /etc/passwd`" 2>/dev/null
  fi
}

# A system without cron (a container image, a minimal install) has nothing
# here to check, and its absent cron.allow restricts nothing worth a word
cron=
for f in /usr/sbin/cron /usr/sbin/crond /usr/bin/crond /usr/sbin/fcron /usr/sbin/busybox-cron /etc/crontab
do
  [ -e "`__here $f`" ] && { cron=Y; break; }
done
[ -n "$cron" ] || [ -d "`__here /var/spool/cron`" ] || {
  echo "# No cron here: nothing to check."
  exit 0
}

lowner=

{
  $GEN_CRON_FILES $WORKDIR/cron.in.$$

  # The files cron reads: whoever can write one decides what it runs, and
  # as whom (root, for the system's)
  $AWK -F'\t' '$1 == "F" { print $2 "\t" $3 }' $WORKDIR/cron.in.$$ |
  while IFS='	' read whose file
  do
    set -- `getpermit "$file"`
    [ $# -ge 12 ] || continue
    owner=$2 group=$3 gw=$8 ow=${11}
    case "$whose" in *'|'*) want="root or ${whose#root|}" ;; *) want=$whose ;; esac
    case "|$whose|" in
      *"|$owner|"*) ;;
      *) message WARN cron009w "" "\`$file' is owned by $owner, not $want: $owner can change what cron runs from it." ;;
    esac
    case "$gw$ow" in
      01|11) message FAIL cron008f "chmod go-w '$file'" "\`$file' is writable by everyone: anyone can have cron run commands as ${whose#root|}." ;;
      10) message WARN cron008w "chmod g-w '$file'" "\`$file' is writable by group \`$group': its members can have cron run commands as ${whose#root|}." ;;
    esac
  done

  # Crontabs in the spool for no account of the system's
  $AWK -F'\t' '$1 == "U" { print $2 }' $WORKDIR/cron.in.$$ |
  while read file
  do
    message WARN cron010w "" "\`$file' is a crontab for ${file##*/}, which is no account here: cron leaves it alone until an account of that name is made, and then runs it as that account."
  done

  #
  # Be careful if you muck around in this loop.  Since we are reading
  # commands from these cron entries, they can have shell meta-characters
  # in them.  We try to eliminate some of them, but there is no guarantee.
  #                                                   dls
  #
  $AWK -F'\t' '$1 == "J" { print $2 "\t" $4 }' $WORKDIR/cron.in.$$ |
  while IFS='	' read owner command
  do
    com="`echo \"$command\" | $SED -e 's/[0-9]*>//g' | $TR -d '()\;\`&!|'`"

    # Can't 'set' this because of shell meta-characters.
    cmd="`echo \"$com\" | $AWK '{print $1}'`"
  
    # A shell running a script: the script is the command, or with -c, the
    # first word of what it is given
    base=`$BASENAME -- "$cmd" 2>/dev/null`
    case "$base" in
      sh|csh|ksh|tcsh|zsh|bash|dash)
        if [ "`echo \"$com\" | $AWK '{print $2}'`" = "-c" ]; then
          cmd="`echo \"$com\" | $AWK '{print $3}' | $TR -d \"'\\\"\"`"
        else
          cmd="`echo \"$com\" | $AWK '{print $2}'`"
        fi ;;
      if|cd)
        cmd="`echo \"$com\" | $AWK '{print $2}'`" ;;
    esac

    [ -n "$TigerCheckEmbedded" ] && [ -f "`__here \"$cmd\"`" ] && [ "$owner" = 'root' ] && {
      echo "$cmd root.crontab" >> $TigerCheckEmbedded
    }
    # cron runs each job with /bin/sh: its builtins and keywords need no path
    case "$cmd" in
      /*|test|\[|true|false|:|echo|printf|umask|cd|export|set|exec|if|'{'|'') ;;
      *) message WARN cron001w "" "cron entry for $owner does not use full pathname ($cmd):" ;;
    esac

    [ "$owner" != "$lowner" ] && {
      curdir=`homeof "$owner"`
      [ -n "$curdir" ] || curdir=/
      lowner=$owner
    }
    setcurdir=0
    set -f
    for comp in $com
    do
      [ $setcurdir -eq 1 ] && {
	curdir="$comp"
	setcurdir=0
      }
      
      case "$comp" in
	*/*) {

	  case "$comp" in
	    /*) ;;
	    *) comp="$curdir/$comp";;
	  esac

	  here=`__here "$comp"`
	  [ ! -c "$here" -a ! -b "$here" ] && {
	    lgetpermit "$comp" |
	    pathmsg cron002 cron003 "$comp" $owner "cron entry for $owner uses" "$command"
	  }
	}
	;;
	cd) setcurdir=1;;
      esac
    done
    set +f
  done
} |
$OUTPUTMETHOD

delete $WORKDIR/cron.in.$$


# Check for existence of root crontab
# Not having a root crontab is not a weakness; on systemd systems it is
# the norm. Worth knowing, not worth a warning.
[ ! -r "`__here /var/spool/cron/crontabs/root`" ] && [ ! -r "`__here /var/spool/cron/root`" ] &&
     message INFO cron004w "" "Root crontab does not exist"

# Check for existence of root cron.allow
[ -z "$CRONALLOW" ] && CRONALLOW=/etc/cron.allow
[ -z "$CRONDENY" ] && CRONDENY=/etc/cron.deny
allow=`__here $CRONALLOW` deny=`__here $CRONDENY`
if [ -f "$allow" ]
then
   $CAT "$allow" |
   $GREP -v "^#" | 
   while read user
   do
        message WARN cron006w "" "User $user is allowed cron usage."
   done
fi
if [ -f "$deny" ]
then
   $CAT "$deny" |
   $GREP -v "^#" | 
   while read user
   do
        message INFO cron007i "" "User $user is denied cron usage."
   done
fi
if [ ! -f "$allow" -a ! -f "$deny" ]
then
     message WARN cron005w "" "Use of cron is not restricted"
fi

# The same for `at': whoever is allowed it can have the daemon run
# commands as them. Unlike cron, no at.allow and no at.deny means only
# root may use it, so that silence is restriction, not a warning.
[ -z "$ATALLOW" ] && ATALLOW=/etc/at.allow
[ -z "$ATDENY" ] && ATDENY=/etc/at.deny
atallow=`__here $ATALLOW` atdeny=`__here $ATDENY`
if [ -f "$atallow" ]
then
   $CAT "$atallow" |
   $GREP -v "^#" |
   while read user
   do
        message WARN cron011w "" "User $user is allowed at usage."
   done
fi
if [ -f "$atdeny" ]
then
   $CAT "$atdeny" |
   $GREP -v "^#" |
   while read user
   do
        message INFO cron012i "" "User $user is denied at usage."
   done
fi

exit 0
