#!/bin/sh
#
#     tiger - A UN*X security checking system
#     Copyright (C) 2026 Andrei Trimbitas
#
#    This program is free software; you can redistribute it and/or modify
#    it under the terms of the GNU General Public License as published by
#    the Free Software Foundation; either version 2, or (at your option)
#    any later version.
#
#    This program is distributed in the hope that it will be useful,
#    but WITHOUT ANY WARRANTY; without even the implied warranty of
#    MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
#    GNU General Public License for more details.
#
#     Please see the file `COPYING' for the complete copyright notice.
#
# check_nfsd: whether the NFS daemons answer, against what /etc/exports
#             configures. A server nobody should use is attack surface
#             with no purpose; configured exports with no server are
#             dead configuration until the server starts, and live
#             shares the moment it does.
#
# 10/09/2026 - Initial version. Serving is read two ways: rpcinfo's
#             registrations (Tiger_RPCInfo_Cmd feeds fixtures, default
#             "rpcinfo -p"), and the kernel's nfsd threads, which catch
#             an NFSv4-only server that needs no rpcbind. The threads
#             come from Tiger_ProcDir (/proc for the tests' fixtures).
#             When rpcinfo cannot run, nothing can be said either way,
#             so nothing is.
#
# References:
#   rpcinfo(8), exports(5)
#
# Tigris: live system
#   Under --root it is skipped: answering is live state, and the
#   export entries themselves are check_exports' offline business.
#
#-----------------------------------------------------------------------------
#
TigerInstallDir='.'

#
# Set default base directory.
# Order or preference:
#      -B option
#      TIGERHOMEDIR environment variable
#      TigerInstallDir installed location
#
basedir=${TIGERHOMEDIR:=$TigerInstallDir}

for parm
do
   case $parm in
   -B) basedir=$2; break;;
   esac
done

#
# Verify that a config file exists there, and if it does
# source it.
#
[ ! -r $basedir/config ] && {
  echo "--ERROR-- [init002e] No 'config' file in \`$basedir'."
  exit 1
}

. $basedir/config

. $BASEDIR/initdefs
#
# If run in test mode (-t) this will verify that all required
# elements are set.
#
[ "$Tiger_TESTMODE" = 'Y' ] && {
  haveallcmds CAT GREP || exit 1
  haveallfiles BASEDIR WORKDIR || exit 1

  echo "--CONFIG-- [init003c] $0: Configuration ok..."
  exit 0
}

#------------------------------------------------------------------------

haveallcmds CAT GREP || exit 1

echo
echo "# Checking NFS daemons against exports..."

# Serving, two ways: rpcinfo's registrations, and the kernel's nfsd
# threads (an NFSv4-only server needs no rpcinfo). When rpcinfo cannot
# run, nothing can be said either way.
rpcinfo=${Tiger_RPCInfo_Cmd:-}
[ -z "$rpcinfo" ] && { rpcinfo=`findtool rpcinfo 2>/dev/null` && rpcinfo="$rpcinfo -p" || rpcinfo=; }
[ -z "$rpcinfo" ] && exit 0
rpcout=`$rpcinfo 2>/dev/null` || exit 0

evidence=
case "$rpcout" in
  *" 100003 "*) evidence="rpcinfo registers nfs" ;;
esac
threads=`$CAT "${Tiger_ProcDir:-/proc}/fs/nfsd/threads" 2>/dev/null`
case "$threads" in
  ''|0) ;;
  *) [ -n "$evidence" ] && evidence="$evidence and the kernel runs nfsd threads" ||
    evidence="the kernel runs nfsd threads" ;;
esac

# Configured exports: what /etc/exports holds besides comments and
# blank lines (the entries themselves are check_exports' business)
exports=0
exp=`rootfile /etc/exports`
if [ -f "$exp" ] && $GREP -v '^[ 	]*#' "$exp" 2>/dev/null | $GREP -q '[^ 	]'; then
  exports=1
fi

if [ -n "$evidence" ] && [ "$exports" = 0 ]; then
  message WARN nfs015w "Stop the server ('systemctl disable --now nfs-server') or export what it should serve." "NFS serves clients ($evidence) but /etc/exports exports nothing: an attack surface with no purpose."
elif [ -z "$evidence" ] && [ "$exports" = 1 ]; then
  message INFO nfs016i "" "Exports are configured in /etc/exports but no NFS daemon answers (neither rpcinfo registrations nor nfsd threads): dead configuration while it stays down, live shares the moment it starts."
fi

exit 0
