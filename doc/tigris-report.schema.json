{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/creativeheadz/tigris/blob/master/doc/tigris-report.schema.json",
  "title": "Tigris report record, schema version 1",
  "description": "One line of a Tigris .jsonl report, or the object printed by tigris-diff -j. See doc/json-format.md. Consumers should ignore fields and record types they do not know: adding either does not change the schema version.",
  "oneOf": [
    { "$ref": "#/$defs/run" },
    { "$ref": "#/$defs/finding" },
    { "$ref": "#/$defs/summary" },
    { "$ref": "#/$defs/diff" }
  ],
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "UTC, second precision, always with a trailing Z."
    },
    "run": {
      "description": "First line of a report: which run this is.",
      "type": "object",
      "required": ["type", "schema", "id", "tool", "version", "host", "os", "release", "arch", "start"],
      "properties": {
        "type": { "const": "run" },
        "schema": { "const": 1, "description": "Report format version." },
        "id": { "type": "string", "minLength": 1, "description": "Unique to the run; the summary repeats it." },
        "tool": { "const": "tigris" },
        "version": { "type": "string", "minLength": 1 },
        "host": { "type": "string", "minLength": 1 },
        "os": { "type": "string" },
        "release": { "type": "string" },
        "arch": { "type": "string" },
        "config": { "type": "string", "description": "Path of the tigerrc the run used." },
        "start": { "$ref": "#/$defs/timestamp" }
      }
    },
    "finding": {
      "description": "One result of one check.",
      "type": "object",
      "required": ["type", "level", "id", "check", "message"],
      "properties": {
        "type": { "const": "finding" },
        "level": { "enum": ["ALERT", "FAIL", "WARN", "INFO", "ERROR"] },
        "id": {
          "type": "string",
          "pattern": "^[a-z]{3,6}[0-9]{3}[a-z]$",
          "description": "Stable message id, e.g. lin016f; the last letter repeats the level (a alert, f fail, w warn, i info, e error, c config)."
        },
        "check": { "type": "string", "minLength": 1, "description": "The script that reported it." },
        "message": { "type": "string" },
        "detail": { "type": "string", "description": "Extra lines the check printed under the message." },
        "accepted": {
          "description": "Present when the finding was accepted with tigris-accept; it is then not in the text report.",
          "type": "object",
          "required": ["reason", "until"],
          "properties": {
            "reason": { "type": "string", "minLength": 1 },
            "until": { "type": "string", "pattern": "^(-|[0-9]{4}-[0-9]{2}-[0-9]{2})$", "description": "YYYY-MM-DD, or - for no expiry." }
          }
        }
      }
    },
    "summary": {
      "description": "Last line of a report. A report without one was cut short.",
      "type": "object",
      "required": ["type", "id", "end", "counts"],
      "properties": {
        "type": { "const": "summary" },
        "id": { "type": "string", "minLength": 1 },
        "end": { "$ref": "#/$defs/timestamp" },
        "counts": {
          "type": "object",
          "required": ["ALERT", "FAIL", "WARN", "INFO", "ERROR"],
          "properties": {
            "ALERT": { "type": "integer", "minimum": 0 },
            "FAIL": { "type": "integer", "minimum": 0 },
            "WARN": { "type": "integer", "minimum": 0 },
            "INFO": { "type": "integer", "minimum": 0 },
            "ERROR": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "diff": {
      "description": "What tigris-diff -j prints.",
      "type": "object",
      "required": ["type", "from", "to", "new", "resolved", "unchanged"],
      "properties": {
        "type": { "const": "diff" },
        "from": { "oneOf": [{ "$ref": "#/$defs/run" }, { "type": "null" }] },
        "to": { "oneOf": [{ "$ref": "#/$defs/run" }, { "type": "null" }] },
        "new": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "resolved": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "unchanged": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
